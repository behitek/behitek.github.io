---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/ContactForm.astro';
import { useTranslations } from '@/i18n/ui';

const lang = 'vi';
const t = useTranslations(lang);
---

<BaseLayout
  title={t('contact.meta_title')}
  description={t('contact.meta_desc')}
  lang={lang}
>
  <div class="rgrid grid grid-cols-[1fr_400px]">
    <div class="rpad border-r-2 border-ink px-8 py-10 lg:px-12 lg:py-12">
      <div class="kicker mb-3">$ cat contact.md</div>
      <h1 class="mb-4 font-heading text-[32px] font-extrabold text-ink lg:text-[40px]">{t('contact.title')}</h1>
      <p class="mb-8 text-[15px] leading-relaxed text-neutral-700">
        {t('contact.subtitle')}
      </p>
      <div class="text-sm leading-loose text-neutral-700">
        01. Phản hồi trong 24h kèm câu hỏi làm rõ<br />
        02. Gọi 30 phút trao đổi phạm vi (miễn phí)<br />
        03. Báo giá cố định + kế hoạch triển khai
      </div>
    </div>

    <ContactForm lang={lang} />
  </div>
</BaseLayout>
