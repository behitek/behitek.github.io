---
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/ContactForm.astro';
---

<BaseLayout
  title="Liên hệ"
  description="Mô tả ngắn gọn nhu cầu của bạn, tôi sẽ phản hồi kèm đề xuất và báo giá sơ bộ trong 1 ngày làm việc."
>
  <div class="rgrid grid grid-cols-[1fr_400px]">
    <div class="rpad border-r-2 border-ink px-8 py-10 lg:px-12 lg:py-12">
      <div class="kicker mb-3">$ cat contact.md</div>
      <h1 class="mb-4 font-heading text-[32px] font-extrabold text-ink lg:text-[40px]">Liên hệ hợp tác</h1>
      <p class="mb-8 text-[15px] leading-relaxed text-neutral-700">
        Mô tả ngắn gọn nhu cầu của bạn, tôi sẽ phản hồi kèm đề xuất và báo giá sơ bộ trong 1 ngày làm việc.
      </p>
      <div class="text-sm leading-[2] text-neutral-700">
        01. Tôi phản hồi trong 24h kèm câu hỏi làm rõ<br />
        02. Gọi 30 phút trao đổi phạm vi (miễn phí)<br />
        03. Báo giá cố định + kế hoạch triển khai
      </div>
    </div>

    <ContactForm />
  </div>
</BaseLayout>
