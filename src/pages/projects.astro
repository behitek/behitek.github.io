---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import ImageGalleryModal from '@components/ImageGalleryModal.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Dự án"
  description="Sản phẩm AI và hệ thống tôi đã xây dựng — kèm số liệu và bài học triển khai."
>
  <div class="px-12 pt-14 pb-8">
    <div class="kicker mb-3.5">$ ls ./projects --featured</div>
    <h1 class="font-heading font-extrabold text-[48px] text-ink mb-2.5">Dự án &amp; case study</h1>
    <p class="text-base leading-relaxed text-neutral-700 m-0 max-w-[640px]">
      Sản phẩm AI và hệ thống tôi đã xây dựng — kèm số liệu và bài học triển khai.
    </p>
  </div>

  <div class="px-12 pb-14 flex flex-col gap-6">
    {
      sortedProjects.map((project) => (
        <ProjectCard {...project.data} id={project.data.id} />
      ))
    }
  </div>

  <ImageGalleryModal
    projects={sortedProjects.map((p) => ({ id: p.data.id, title: p.data.title, images: p.data.images }))}
  />
</BaseLayout>
