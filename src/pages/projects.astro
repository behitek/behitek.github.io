---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import ImageGalleryModal from '@components/ImageGalleryModal.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Dự án"
  description="Sản phẩm AI và hệ thống tôi đã xây dựng (kèm số liệu và bài học triển khai)."
>
  <div class="px-6 py-10 lg:px-12 lg:py-14">
    <div class="mb-8">
      <div class="kicker mb-3">$ ls -la ./projects/</div>
      <h1 class="mb-3 font-heading text-[32px] font-extrabold text-ink lg:text-[40px]">Sản phẩm & Dự án</h1>
      <p class="m-0 text-[15px] text-neutral-700">
        Sản phẩm AI và hệ thống tôi đã xây dựng (kèm số liệu và bài học triển khai).
      </p>
    </div>
  </div>

  <div class="px-12 pb-14 flex flex-col gap-6">
    {
      sortedProjects.map((project) => (
        <ProjectCard {...project.data} id={project.data.id} />
      ))
    }
  </div>

  <ImageGalleryModal
    projects={sortedProjects.map((p) => ({ id: p.data.id, title: p.data.title, images: p.data.images }))}
  />
</BaseLayout>
