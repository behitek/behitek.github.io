---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceHero from '@components/ServiceHero.astro';
import ServiceTabs from '@components/ServiceTabs.astro';
import ServiceFeatureGrid from '@components/ServiceFeatureGrid.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import PricingSplit from '@components/PricingSplit.astro';
import TestimonialSplit from '@components/TestimonialSplit.astro';
import CTABand from '@components/CTABand.astro';

const FEATURES = [
  {
    kicker: '01',
    title: 'Hạ tầng & cài đặt',
    bullets: ['DMOJ + judge server', 'Tên miền, SSL, email', 'Bàn giao tài liệu quản trị'],
  },
  {
    kicker: '02',
    title: 'Thương hiệu & vận hành',
    bullets: ['Tùy biến giao diện, thương hiệu', 'Backup + giám sát 24/7', 'Cập nhật, hỗ trợ kỹ thuật'],
    highlighted: true,
  },
  {
    kicker: '03',
    title: 'Nội dung & mở rộng',
    bullets: ['Ngân hàng 1000+ bài tập', 'Tính năng riêng (LMS, thanh toán…)', 'Đào tạo đội ngũ quản trị'],
  },
];

const STEPS = [
  { number: '01', title: 'Trao đổi yêu cầu', description: '30 phút gọi, xác định quy mô và hạ tầng.' },
  {
    number: '02',
    title: 'Kế hoạch triển khai',
    description: 'Mốc thời gian rõ ràng; đơn vị thương mại nhận đề xuất chi phí.',
  },
  { number: '03', title: 'Triển khai', description: 'Thường 1–2 tuần, bàn giao kèm tài liệu.' },
  { number: '04', title: 'Vận hành dài hạn', description: 'Giám sát, backup, cập nhật định kỳ.' },
];
---

<BaseLayout
  title="Online Judge (DMOJ)"
  description="Triển khai & vận hành Online Judge trên nền DMOJ cho trường học và trung tâm dạy lập trình."
>
  <ServiceTabs active="online-judge" />
  <ServiceHero
    breadcrumb="online-judge"
    title="Triển khai & vận hành Online Judge trên nền DMOJ"
    description="Hệ thống chấm bài tự động trọn gói cho trường học và trung tâm dạy lập trình: cài đặt, tùy biến thương hiệu, ngân hàng đề, và vận hành dài hạn. Miễn phí cho tổ chức giáo dục phi lợi nhuận, chi phí theo quy mô cho đơn vị khác — đã triển khai cho 3 đơn vị đang hoạt động."
    ctas={[
      { label: 'Đăng ký triển khai →', href: '/contact', variant: 'primary' },
      { label: 'Xem hệ thống demo', href: 'https://luyencode.net', variant: 'secondary', external: true },
    ]}
  />

  <div class="px-12 pb-12">
    <ServiceFeatureGrid features={FEATURES} />
    <PricingSplit />
  </div>

  <div class="px-12 pb-12">
    <ProcessSteps kicker="$ ./process" steps={STEPS} />
  </div>

  <TestimonialSplit />

  <CTABand title="Cần online judge cho đơn vị của bạn?" buttonLabel="Liên hệ triển khai →" />
</BaseLayout>
