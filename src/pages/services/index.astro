---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceHero from '@components/ServiceHero.astro';
import ServiceTabs from '@components/ServiceTabs.astro';
import ServiceFeatureGrid from '@components/ServiceFeatureGrid.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import ServiceTiers from '@components/ServiceTiers.astro';
import CTABand from '@components/CTABand.astro';
import OrgRoster from '@components/OrgRoster.astro';
import FAQ from '@components/FAQ.astro';
import {
  ORGANIZATIONS,
  DEPLOYMENTS,
  TOTAL_ORG_MEMBERS,
  TOTAL_PLATFORM_USERS,
  TOTAL_PROBLEMS,
  TOTAL_SUBMISSIONS,
} from '@/data/organizations';

const FEATURES = [
  {
    kicker: '01',
    title: 'Hạ tầng & cài đặt',
    bullets: ['DMOJ + judge server', 'Tên miền, SSL, email', 'Bàn giao tài liệu quản trị'],
  },
  {
    kicker: '02',
    title: 'Thương hiệu & vận hành',
    bullets: [
      'Tùy biến giao diện, thương hiệu',
      'Backup + giám sát 24/7',
      'Cập nhật, hỗ trợ kỹ thuật',
    ],
    highlighted: true,
  },
  {
    kicker: '03',
    title: 'Nội dung & mở rộng',
    bullets: [
      `Ngân hàng ${TOTAL_PROBLEMS} bài tập`,
      'Tính năng riêng (LMS, thanh toán…)',
      'Đào tạo đội ngũ quản trị',
    ],
  },
];

const STEPS = [
  {
    number: '01',
    title: 'Trao đổi yêu cầu',
    description: '30 phút gọi, xác định quy mô và hạ tầng.',
  },
  {
    number: '02',
    title: 'Kế hoạch triển khai',
    description: 'Mốc thời gian rõ ràng; đơn vị thương mại nhận đề xuất chi phí.',
  },
  { number: '03', title: 'Triển khai', description: 'Thường 1–2 tuần, bàn giao kèm tài liệu.' },
  { number: '04', title: 'Vận hành dài hạn', description: 'Giám sát, backup, cập nhật định kỳ.' },
];

const FAQ_ITEMS = [
  {
    question: 'Dữ liệu của trường thuộc về ai?',
    answer:
      'Dữ liệu học sinh, bài tập và kết quả thi thuộc về đơn vị. Với gói triển khai trọn gói, toàn bộ dữ liệu nằm trên hạ tầng của đơn vị. Với gói miễn phí trên luyencode.net, đơn vị có thể yêu cầu xuất dữ liệu bất cứ lúc nào.',
  },
  {
    question: 'Nếu sau này anh không duy trì hệ thống nữa thì sao?',
    answer:
      'Hệ thống dựa trên DMOJ — một nền tảng mã nguồn mở đã được cộng đồng quốc tế duy trì nhiều năm, không phải phần mềm riêng của tôi. Toàn bộ cấu hình và tài liệu quản trị được bàn giao cho đơn vị, nên một kỹ thuật viên khác có thể tiếp quản. luyencode.net đã chạy liên tục từ 2020.',
  },
  {
    question: 'Trường có cần máy chủ riêng không?',
    answer:
      'Không, nếu chọn gói miễn phí trên luyencode.net — hệ thống chạy trên hạ tầng chung. Gói triển khai riêng cần máy chủ (VPS), và tôi sẽ tư vấn cấu hình phù hợp với quy mô để tránh trả tiền thừa; nếu là tổ chức giáo dục phi lợi nhuận chưa có domain, có thể dùng subdomain miễn phí trên luyencode.net để tiết kiệm thêm.',
  },
  {
    question: 'Trường có thể dùng đề của mình không?',
    answer:
      'Có, nhưng tùy gói. Tổ chức trên luyencode.net được dùng toàn bộ ngân hàng đề sẵn có, miễn phí. Với gói triển khai riêng, hệ thống không đi kèm ngân hàng đề của luyencode — đơn vị tự tạo đề riêng hoặc nhập đề từ định dạng phổ biến.',
  },
  {
    question: 'Hệ thống riêng không có ngân hàng đề, phải làm sao?',
    answer:
      'Tôi hỗ trợ soạn đề với chi phí rất thấp, nhờ dùng AI hỗ trợ tạo nội dung — đã có kinh nghiệm và triển khai thành công thực tế. Phù hợp cho đơn vị triển khai riêng cần xây ngân hàng đề nhanh, không phải soạn thủ công từ đầu.',
  },
  {
    question:
      'Đang dùng gói miễn phí, sau này muốn chuyển sang hệ thống riêng thì có mất dữ liệu không?',
    answer:
      'Không. Dữ liệu tổ chức được chuyển sang hệ thống mới khi nâng cấp. Đây là đường đi bình thường: bắt đầu miễn phí, khi quy mô lớn hơn thì chuyển sang hạ tầng riêng.',
  },
  {
    question: 'Hệ thống có chịu được kỳ thi đông người cùng nộp bài không?',
    answer:
      'Có. Hệ thống dùng hàng đợi chấm bài tách riêng khỏi web, nên lượng nộp tăng đột biến không làm treo giao diện. Các kỳ thi thử với hàng trăm thí sinh đồng thời đã chạy ổn định trên hạ tầng hiện tại.',
  },
];
---

<BaseLayout
  title="Online Judge (DMOJ)"
  description="Triển khai & vận hành Online Judge trên nền DMOJ cho trường học và trung tâm dạy lập trình."
>
  <ServiceTabs active="online-judge" />
  <ServiceHero
    breadcrumb="online-judge"
    title="Triển khai & vận hành Online Judge trên nền DMOJ"
    description={`Hệ thống chấm bài tự động cho trường học và trung tâm dạy lập trình. Hai cách bắt đầu: dùng miễn phí trên luyencode.net, hoặc triển khai riêng trên VPS với tên miền của bạn — hay subdomain miễn phí nếu là tổ chức giáo dục phi lợi nhuận. Hiện có ${ORGANIZATIONS.length} trường và tổ chức đang sử dụng, cùng ${DEPLOYMENTS.length} hệ thống chạy độc lập.`}
    ctas={[
      { label: 'Bắt đầu ngay →', href: '/contact', variant: 'primary' },
      {
        label: 'Xem hệ thống demo',
        href: 'https://luyencode.net',
        variant: 'secondary',
        external: true,
      },
    ]}
  />

  <div class="px-12 pb-12">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">01 /</span>
      <h2 class="m-0 font-heading text-[34px] font-extrabold text-ink">Hai cách bắt đầu</h2>
    </div>
    <ServiceTiers />
  </div>

  <section class="px-12 pb-12">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">02 /</span>
      <h2 class="m-0 font-heading text-[34px] font-extrabold text-ink">Đang chạy ở đâu</h2>
    </div>
    <div class="border-2 border-ink bg-white p-8">
      <div class="mb-4 font-mono text-[11px] font-semibold tracking-[0.08em] text-neutral-600">
        {ORGANIZATIONS.length} TỔ CHỨC TRÊN LUYENCODE.NET — {
          TOTAL_ORG_MEMBERS.toLocaleString('vi-VN')
        } THÀNH VIÊN
      </div>
      <OrgRoster variant="full" />
      <div class="mb-4 mt-8 font-mono text-[11px] font-semibold tracking-[0.08em] text-neutral-600">
        HỆ THỐNG CHẠY ĐỘC LẬP
      </div>
      <div class="border-t-2 border-ink">
        {
          DEPLOYMENTS.map((d) => (
            <a
              href={d.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-baseline gap-3 border-b border-border-light py-3 font-mono text-[13px] text-ink no-underline hover:text-accent"
            >
              <span class="flex-none text-accent">●</span>
              <span class="font-semibold">{d.name}</span>
              <span class="text-neutral-600">— {d.note}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="px-12 pb-12">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">03 /</span>
      <h2 class="m-0 font-heading text-[34px] font-extrabold text-ink">Có gì trong đó</h2>
    </div>
    <ServiceFeatureGrid features={FEATURES} />
  </div>

  <section class="px-12 pb-12">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">04 /</span>
      <h2 class="m-0 font-heading text-[34px] font-extrabold text-ink">Quy mô hệ thống</h2>
    </div>
    <div class="border-2 border-ink bg-white">
      <div class="rgrid grid grid-cols-3">
        <div class="border-r-2 border-ink p-8">
          <div class="mb-2 font-heading text-[46px] font-extrabold leading-none text-accent">
            {TOTAL_PROBLEMS}
          </div>
          <div class="font-mono text-[13px] text-neutral-600">
            bài tập kèm lời giải, dùng được ngay
          </div>
        </div>
        <div class="border-r-2 border-ink p-8">
          <div class="mb-2 font-heading text-[46px] font-extrabold leading-none text-accent">
            {TOTAL_PLATFORM_USERS}
          </div>
          <div class="font-mono text-[13px] text-neutral-600">người dùng trên toàn hệ thống</div>
        </div>
        <div class="p-8">
          <div class="mb-2 font-heading text-[46px] font-extrabold leading-none text-accent">
            {TOTAL_SUBMISSIONS}
          </div>
          <div class="font-mono text-[13px] text-neutral-600">lượt chấm bài đã xử lý</div>
        </div>
      </div>
      <p class="m-0 border-t-2 border-ink p-8 text-[14.5px] leading-relaxed text-neutral-700">
        Đơn vị không phải bắt đầu từ con số không. Ngân hàng đề phân theo chủ đề và độ khó, từ bài
        nhập môn tới bài luyện đội tuyển, kèm lời giải và bộ test. Giáo viên có thể dùng trực tiếp,
        chỉnh sửa, hoặc thêm đề riêng của trường.
      </p>
    </div>
  </section>

  <div class="px-12 pb-12">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">05 /</span>
      <h2 class="m-0 font-heading text-[34px] font-extrabold text-ink">Quy trình</h2>
    </div>
    <ProcessSteps kicker="$ ./process" steps={STEPS} />
  </div>

  <div class="px-12 pb-12">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">06 /</span>
      <h2 class="m-0 font-heading text-[34px] font-extrabold text-ink">Câu hỏi thường gặp</h2>
    </div>
    <FAQ items={FAQ_ITEMS} />
  </div>

  <CTABand title="Cần online judge cho đơn vị của bạn?" buttonLabel="Liên hệ ngay →" />
</BaseLayout>
