---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Không tìm thấy trang" description="Trang bạn tìm không tồn tại.">
  <div class="px-12 py-24 text-center max-w-2xl mx-auto">
    <div class="font-heading font-extrabold text-9xl text-accent mb-6">404</div>

    <h1 class="font-heading font-extrabold text-3xl md:text-4xl text-ink mb-4">Không tìm thấy trang</h1>
    <p class="text-lg text-neutral-700 mb-10">Có vẻ bạn đã lạc vào vùng chưa được lập trình.</p>

    <div class="grid grid-cols-1 md:grid-cols-3 border-2 border-ink mb-10">
      <a href="/" class="p-6 border-b-2 md:border-b-0 md:border-r-2 border-ink text-center no-underline hover:bg-neutral-100">
        <h3 class="font-heading font-bold text-ink">Trang chủ</h3>
        <p class="text-sm text-neutral-600 m-0">Quay lại trang chủ</p>
      </a>
      <a href="/blog" class="p-6 border-b-2 md:border-b-0 md:border-r-2 border-ink text-center no-underline hover:bg-neutral-100">
        <h3 class="font-heading font-bold text-ink">Blog</h3>
        <p class="text-sm text-neutral-600 m-0">Đọc bài viết</p>
      </a>
      <a href="/projects" class="p-6 text-center no-underline hover:bg-neutral-100">
        <h3 class="font-heading font-bold text-ink">Dự án</h3>
        <p class="text-sm text-neutral-600 m-0">Xem dự án</p>
      </a>
    </div>

    <p class="text-neutral-700">
      Vẫn chưa tìm thấy? <a href="/contact" class="link">Liên hệ</a> và tôi sẽ giúp bạn.
    </p>
  </div>
</BaseLayout>
