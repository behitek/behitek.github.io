---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceHero from '@components/ServiceHero.astro';
import ServiceTabs from '@components/ServiceTabs.astro';
import ServiceFeatureGrid from '@components/ServiceFeatureGrid.astro';
import ProcessSteps from '@components/ProcessSteps.astro';
import CTABand from '@components/CTABand.astro';
import CaseStudySpotlight from '@components/CaseStudySpotlight.astro';
import CaseStudyCard from '@components/CaseStudyCard.astro';
import PipelineDiagram from '@components/PipelineDiagram.astro';
import { getNexusAI, getNexusPipeline, getLinguistAI, getKikiASR } from '@/data/ai-work';
import { useTranslations } from '@/i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
const nexusAI = getNexusAI(lang);
const nexusPipeline = getNexusPipeline(lang);
const linguistAI = getLinguistAI(lang);
const kikiASR = getKikiASR(lang);

const FEATURES = [
  {
    kicker: 'MODULE 01',
    title: 'Chatbots & Enterprise Assistants',
    bullets: [
      'Retrieval on enterprise knowledge bases',
      'Slack, Web, and messaging integrations',
      'Safety guardrails & inference cost control',
    ],
  },
  {
    kicker: 'MODULE 02',
    title: 'RAG & Semantic Search',
    bullets: ['Dense Vector + BM25 Hybrid Search & Re-ranking', 'Document, Image, and Video indexing', 'Retrieval accuracy benchmarking'],
    highlighted: true,
  },
  {
    kicker: 'MODULE 03',
    title: 'Fine-tuning & Model Evaluation',
    bullets: [
      'LoRA / SFT on proprietary data',
      'Quantitative baseline comparison benchmarks',
      'Inference speed optimization & self-hosting',
    ],
  },
];

const STEPS = [
  {
    number: '01',
    title: 'Architecture Advisory',
    description: 'Assess business domain requirements, model selection, and stack budgeting.',
  },
  {
    number: '02',
    title: '2–4 Week PoC',
    description: 'Functional prototype on real enterprise data with evaluation metrics.',
  },
  {
    number: '03',
    title: 'Production Deployment',
    description: 'Cloud deployment, cost/quality observability, and full documentation handoff.',
  },
];
---

<BaseLayout
  title={t('services.ai_title')}
  description={t('services.ai_meta_desc')}
  lang={lang}
>
  <ServiceTabs active="ai" lang={lang} />
  <ServiceHero
    breadcrumb="ai"
    title="AI Systems: From PoC to Production"
    description="Enterprise RAG, LLMs, and NLP solutions for real business impact: architecture consulting, rapid PoC development, and production deployment with predictable operating costs."
    ctas={[
      { label: 'Schedule Consultation →', href: '/en/contact?need=ai', variant: 'primary' },
      { label: 'View Case Studies', href: '#case-study', variant: 'secondary' },
    ]}
  />

  <div class="px-6 lg:px-12 pb-12">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">01 /</span>
      <h2 class="m-0 font-heading text-[34px] font-extrabold text-ink">Service Capabilities</h2>
    </div>
    <ServiceFeatureGrid features={FEATURES} />
  </div>

  <section id="case-study" class="px-6 lg:px-12 pb-12">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">02 /</span>
      <h2 class="m-0 font-heading text-[34px] font-extrabold text-ink">Case Studies</h2>
    </div>
    <CaseStudySpotlight
      kicker={nexusAI.kicker}
      title={nexusAI.title}
      description={nexusAI.description}
      stats={nexusAI.stats}
    >
      <PipelineDiagram slot="media" stages={nexusPipeline} caption="SYSTEM ARCHITECTURE" />
    </CaseStudySpotlight>
    <div class="rgrid mt-7 grid grid-cols-2 border-2 border-ink">
      <CaseStudyCard {...linguistAI} borderRight mobileDivider />
      <CaseStudyCard {...kikiASR} />
    </div>
  </section>

  <div class="px-6 lg:px-12 pb-12">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">03 /</span>
      <h2 class="m-0 font-heading text-[34px] font-extrabold text-ink">Process & Engagement</h2>
    </div>
    <ProcessSteps kicker="$ ./engagement" steps={STEPS} />
  </div>

  <CTABand
    title="Have an AI challenge to solve?"
    buttonLabel="Book a free 30-min call →"
    buttonHref="/en/contact?need=ai"
    lang={lang}
  />
</BaseLayout>
