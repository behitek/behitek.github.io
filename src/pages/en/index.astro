---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import StatBar from '@components/StatBar.astro';
import CaseStudySpotlight from '@components/CaseStudySpotlight.astro';
import PipelineDiagram from '@components/PipelineDiagram.astro';
import ServiceCard from '@components/ServiceCard.astro';
import ProjectMiniCard from '@components/ProjectMiniCard.astro';
import BlogCard from '@components/BlogCard.astro';
import CTABand from '@components/CTABand.astro';
import { SITE } from '@utils/constants';
import { readingTime } from '@utils/helpers';
import { getNexusAI, getNexusPipeline, getServicesList } from '@/data/ai-work';
import { useTranslations } from '@/i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
const nexusAI = getNexusAI(lang);
const nexusPipeline = getNexusPipeline(lang);
const services = getServicesList(lang);

const allProjects = await getCollection('projects');
const FEATURED_PROJECT_ORDER = ['lcoj', 'linguistai', 'behivest'];
const featuredProjects = FEATURED_PROJECT_ORDER.map((id) =>
  allProjects.find((p) => p.data.id === id)
).filter((p): p is NonNullable<typeof p> => Boolean(p));

const PROJECT_METRICS: Record<string, string> = {
  lcoj: '20,000+ USERS',
  linguistai: '4-SKILL EVALUATION',
  behivest: 'FINTECH & TOOLING',
};

const allPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home" description={SITE.description.en} lang={lang}>
  <Hero lang={lang} />
  <StatBar lang={lang} />

  <section id="case-study" class="px-6 py-10 lg:px-12 lg:py-14">
    <div class="mb-6 flex items-baseline gap-4">
      <span class="kicker">{t('home.spotlight_kicker')}</span>
      <h2 class="m-0 font-heading text-[30px] font-extrabold text-ink sm:text-[34px]">
        {t('home.spotlight_title')}
      </h2>
    </div>
    <CaseStudySpotlight
      kicker={nexusAI.kicker}
      title={nexusAI.title}
      description={nexusAI.description}
      stats={nexusAI.stats}
      links={[
        { label: t('spotlight.read_inverted_hyde'), href: '/en/blog/inverted-hyde' },
        { label: t('spotlight.read_rag_practices'), href: '/en/blog/rag-in-production' },
        { label: t('spotlight.consult_enterprise_rag'), href: '/en/services/ai' },
      ]}
    >
      <PipelineDiagram slot="media" stages={nexusPipeline} caption="INVERTED HYDE & MULTIMODAL INDEXING PIPELINE" />
    </CaseStudySpotlight>
  </section>

  <section id="projects" class="px-6 pb-12 pt-4 lg:px-12 lg:pb-14">
    <div class="mb-7 flex items-baseline justify-between">
      <div class="flex items-baseline gap-4">
        <span class="kicker">{t('home.projects_kicker')}</span>
        <h2 class="m-0 font-heading text-[30px] font-extrabold text-ink sm:text-[34px]">
          {t('home.projects_title')}
        </h2>
      </div>
      <a
        href="/en/projects"
        class="hidden font-mono text-[13px] font-semibold text-ink no-underline hover:text-accent sm:inline-block"
      >
        {t('home.projects_all')}
      </a>
    </div>
    <div class="rgrid grid grid-cols-3 border-2 border-ink">
      {
        featuredProjects.map((project, i) => (
          <ProjectMiniCard
            title={project.data.title}
            description={project.data.description_en || project.data.description || ''}
            tech={project.data.tech}
            status={project.data.status}
            metric={PROJECT_METRICS[project.data.id]}
            href={project.data.links?.website || '/en/projects'}
            flagship={project.data.flagship}
            borderRight={i < featuredProjects.length - 1}
            mobileDivider={i < featuredProjects.length - 1}
            lang={lang}
          />
        ))
      }
    </div>
    <a
      href="/en/projects"
      class="mt-5 inline-block font-mono text-[13px] font-semibold text-ink no-underline hover:text-accent sm:hidden"
    >
      {t('home.projects_all_mobile')}
    </a>
  </section>

  <section class="px-6 pb-12 lg:px-12 lg:pb-14">
    <div class="mb-7 flex items-baseline gap-4">
      <span class="kicker">{t('home.services_kicker')}</span>
      <h2 class="m-0 font-heading text-[30px] font-extrabold text-ink sm:text-[34px]">{t('home.services_title')}</h2>
    </div>
    <div class="rgrid grid grid-cols-3 border-2 border-ink">
      {services.map((service) => <ServiceCard {...service} lang={lang} />)}
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section class="px-6 pb-12 lg:px-12 lg:pb-14">
        <div class="mb-5 flex items-baseline justify-between">
          <div class="flex items-baseline gap-4">
            <span class="kicker">{t('home.blog_kicker')}</span>
            <h2 class="m-0 font-heading text-[30px] font-extrabold text-ink sm:text-[34px]">{t('home.blog_title')}</h2>
          </div>
          <a
            href="/en/blog"
            class="font-mono text-[13px] font-semibold text-ink no-underline hover:text-accent"
          >
            {t('home.blog_all')}
          </a>
        </div>
        <div class="border-t-2 border-ink">
          {recentPosts.map((post) => (
            <BlogCard
              variant="compact"
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
              language={post.data.language}
              slug={post.slug}
              readingTime={readingTime(post.body)}
              lang={lang}
            />
          ))}
        </div>
      </section>
    )
  }

  <CTABand
    kicker={t('cta.kicker')}
    title={t('cta.title')}
    buttonLabel={t('cta.button')}
    buttonHref="/en/contact"
    size="lg"
    showEmail
    lang={lang}
  />
</BaseLayout>
