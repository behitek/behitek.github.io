---
import BaseLayout from '@layouts/BaseLayout.astro';
import Timeline from '@components/Timeline.astro';
import AwardsList from '@components/AwardsList.astro';
import { SOCIAL_LINKS } from '@utils/constants';
import { useTranslations } from '@/i18n/ui';

const lang = 'en';
const t = useTranslations(lang);

const SKILLS = [
  'Agentic AI',
  'NLP',
  'AI in SDLC',
  'RAG & Inverted HyDE',
  'Python',
  'FastAPI',
  'PyTorch',
  'Docker',
  'Kubernetes',
  'DMOJ / Online Judge',
];

const TIMELINE = [
  {
    years: '2023 - Present',
    role: 'Senior AI Engineer: VMO Holdings',
    description:
      'Lead Enterprise Agentic AI & RAG solutions, architect full-stack AI systems, drive technical bidding, and mentor engineering teams. Honored as Top 30 Employee of the Year.',
    dotAccent: true,
  },
  {
    years: '2021 - Present',
    role: 'Founder & Operator: Luyen Code (LCOJ)',
    description:
      'Engineered and operated an automated competitive programming judge platform based on DMOJ, serving 20,000+ students and 20+ schools/institutions.',
  },
  {
    years: '2019 - 2022',
    role: 'AI Engineer: Zalo Group (VNG)',
    description:
      'Developed ASR & TTS pipelines for KiKi virtual assistant: built text normalization pipeline (+12% ASR accuracy), optimized Kubernetes inference infrastructure (-15% service errors).',
  },
  {
    years: '2020 - 2022',
    role: 'Master of Information Science: JAIST (Japan)',
    description:
      'Researched Machine Learning & Information Retrieval. Awarded full Japanese Government scholarship at Japan Advanced Institute of Science and Technology.',
  },
  {
    years: '2018 - 2019',
    role: 'NLP Developer: VCCorp',
    description:
      'Built real-time NLP spam comment detection systems (Word2Vec, RESTful AI Services, Hadoop/Spark).',
  },
  {
    years: '2014 - 2019',
    role: 'B.S. Software Engineering: Electric Power University',
    description:
      'Graduated with 3.3 GPA. Core team member in ACM/ICPC Vietnam National Programming Contest for 3 consecutive years.',
  },
];

const AWARDS = [
  'Top 30 Employee of the Year, VMO Holdings (2023)',
  'First Prize: ALQAC 2022 (Automated Legal Question Answering Competition)',
  'Champion: AI4VN National Grand Finale Hackathon (2019)',
  'Second Prize: VLSP Speech-to-Text Shared Task (2019)',
  'Second Prize: ACM/ICPC Vietnam National Programming Contest (2018)',
];
---

<BaseLayout
  title={t('about.meta_title')}
  description={t('about.meta_desc')}
  lang={lang}
>
  <div class="rgrid grid grid-cols-[360px_1fr]">
    <div class="rpad border-r-2 border-ink px-8 py-10 lg:px-12 lg:py-12">
      <img
        src="/images/me.png"
        alt="Hieu Nguyen"
        class="grayscale-photo mb-5 block h-[160px] w-[160px] border-2 border-ink object-cover lg:h-[180px] lg:w-[180px]"
      />
      <h1 class="mb-1 font-heading text-[32px] font-extrabold text-ink lg:text-[36px]">Hieu Nguyen</h1>
      <div class="mb-4 font-heading text-[14px] font-bold text-accent lg:text-[15px]">
        {t('about.role')}
      </div>
      <div class="flex flex-col font-mono text-[13px] leading-[2.1] text-ink">
        <a href={SOCIAL_LINKS.email.href}>hello@behitek.com</a>
        <a href={SOCIAL_LINKS.github.href} target="_blank" rel="noopener noreferrer"
          >github.com/behitek</a
        >
        <a href={SOCIAL_LINKS.linkedin.href} target="_blank" rel="noopener noreferrer"
          >linkedin.com/in/behitek</a
        >
      </div>
      <div class="my-5 h-0.5 bg-ink"></div>
      <div class="mb-3 font-mono text-[11px] font-semibold tracking-[0.08em] text-neutral-600">
        {t('about.core_skills')}
      </div>
      <div class="flex flex-wrap gap-1.5">
        {SKILLS.map((s) => <span class="tag-pill text-[11.5px]">{s}</span>)}
      </div>
      <div class="my-5 h-0.5 bg-ink"></div>
      <div class="mb-3 font-mono text-[11px] font-semibold tracking-[0.08em] text-neutral-600">
        LANGUAGES
      </div>
      <div class="text-[13.5px] leading-[1.9] text-ink">
        Vietnamese (Native)<br />
        English (Professional / B2)
      </div>
    </div>

    <div class="p-8 lg:p-12">
      <div class="kicker mb-3">$ cat bio.txt</div>
      <p class="mb-8 text-[15.5px] leading-relaxed text-neutral-800" style="text-wrap: pretty">
        I am a Senior AI Engineer with 8 years of experience taking AI from research into production systems. My core expertise focuses on <strong>Agentic AI</strong> (Enterprise AI Agents & RAG systems), <strong>Natural Language Processing (NLP)</strong>, and <strong>AI in SDLC</strong> (applying AI across full-stack software design, development, and deployment). I engineer both model intelligence and reliable production infrastructure.
      </p>

      <div class="kicker mb-5">$ cat experience.log</div>
      <Timeline entries={TIMELINE} />

      <div class="kicker mb-4 mt-8">$ cat awards.log</div>
      <AwardsList awards={AWARDS} />
    </div>
  </div>
</BaseLayout>
