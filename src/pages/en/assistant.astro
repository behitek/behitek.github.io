---
import BaseLayout from '@layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/ui';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout
  title={t('assistant.meta_title')}
  description={t('assistant.meta_desc')}
  lang={lang}
>
  <div class="section py-10 md:py-16 bg-bg">
    <div class="container max-w-6xl">
      <!-- Top Header & Banner -->
      <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b-2 border-ink pb-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-accent text-bg font-mono text-xs px-2 py-0.5 font-bold uppercase tracking-wider">
              Prototype Mode
            </span>
            <span class="font-mono text-xs text-neutral-600">v0.9.0-alpha</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-heading font-extrabold text-ink tracking-tight">
            Personal AI Assistant Sandbox
          </h1>
          <p class="text-neutral-700 text-sm md:text-base mt-2 max-w-2xl">
            Interactive UI/UX prototype sandbox for Behitek Personal AI Assistant.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a href="/en/contact" class="btn-primary py-2.5 px-4 text-xs font-mono">
            📩 Sign up for Beta access
          </a>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left Column: Interactive Full-Page Chat Simulator (7 cols) -->
        <div class="lg:col-span-7 flex flex-col">
          <div class="card p-0 flex flex-col h-[650px] shadow-[6px_6px_0px_0px_rgba(32,30,29,1)]">
            <!-- Sandbox Header -->
            <div class="bg-ink text-bg px-5 py-4 flex items-center justify-between border-b-2 border-ink">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-accent text-bg font-mono font-bold flex items-center justify-center border border-bg">
                  🤖
                </div>
                <div>
                  <h2 class="text-base font-extrabold font-heading text-bg leading-none">behitek_assistant_full</h2>
                  <span class="font-mono text-[11px] text-accent-300">Persona: General Assistant & Solutions Advisor</span>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 font-mono text-[11px] bg-neutral-800 text-neutral-200 px-2 py-1 border border-neutral-700">
                  <span class="w-2 h-2 rounded-full bg-green-400"></span> Live UI Demo
                </span>
              </div>
            </div>

            <!-- Notice Bar -->
            <div class="bg-accent-100 border-b border-ink px-4 py-2 text-xs font-mono text-ink flex items-center justify-between">
              <span>⚠️ <strong>PROTOTYPE:</strong> Messages below are simulated for UX testing.</span>
              <button id="full-chat-reset" class="text-accent underline font-bold hover:text-ink">Reset Chat</button>
            </div>

            <!-- Messages Area -->
            <div id="full-chat-messages" class="flex-1 overflow-y-auto p-5 space-y-4 bg-bg text-sm">
            </div>

            <!-- Prompt Suggestions -->
            <div class="p-3 bg-surface border-t border-ink/20 flex flex-wrap gap-2 text-xs font-mono">
              <span class="text-neutral-500 font-bold self-center mr-1">Suggestions:</span>
              <button type="button" class="full-chip tag-pill bg-white hover:bg-accent hover:text-white transition-colors cursor-pointer" data-prompt="Introduce Behitek and its mission">
                🏢 About Behitek
              </button>
              <button type="button" class="full-chip tag-pill bg-white hover:bg-accent hover:text-white transition-colors cursor-pointer" data-prompt="What AI consulting services are offered?">
                📋 AI Consulting Process
              </button>
              <button type="button" class="full-chip tag-pill bg-white hover:bg-accent hover:text-white transition-colors cursor-pointer" data-prompt="Backend roadmap for this assistant">
                ⚙️ Backend Roadmap
              </button>
            </div>

            <!-- Input Bar -->
            <form id="full-chat-form" class="p-4 bg-white border-t-2 border-ink flex items-center gap-3">
              <input
                id="full-chat-input"
                type="text"
                placeholder="Ask any question to test the assistant interface..."
                class="flex-1 bg-bg border border-ink px-4 py-3 text-sm text-ink focus:outline-none focus:border-accent font-sans"
                autocomplete="off"
              />
              <button type="submit" class="btn-primary py-3 px-5 text-sm flex items-center gap-2">
                <span>Send</span>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                </svg>
              </button>
            </form>
          </div>
        </div>

        <!-- Right Column: Specs & Roadmap (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <div class="card shadow-[4px_4px_0px_0px_rgba(32,30,29,1)]">
            <h3 class="text-lg font-extrabold font-heading text-ink mb-3 flex items-center gap-2">
              <span class="text-accent">●</span> Prototype UI Specifications
            </h3>
            
            <div class="space-y-2 text-xs font-mono border-t border-border-light pt-3">
              <div class="flex justify-between py-1 border-b border-border-light">
                <span class="text-neutral-600">UI Status:</span>
                <span class="font-bold text-accent">🟢 Ready (Active)</span>
              </div>
              <div class="flex justify-between py-1 border-b border-border-light">
                <span class="text-neutral-600">Backend Logic:</span>
                <span class="font-bold text-neutral-800">⏳ Pending Implementation</span>
              </div>
              <div class="flex justify-between py-1 border-b border-border-light">
                <span class="text-neutral-600">Target LLM Engine:</span>
                <span class="font-bold text-ink">Claude 3.5 Sonnet / GPT-4o</span>
              </div>
              <div class="flex justify-between py-1 border-b border-border-light">
                <span class="text-neutral-600">Data Architecture:</span>
                <span class="font-bold text-ink">RAG + Vector Database</span>
              </div>
              <div class="flex justify-between py-1">
                <span class="text-neutral-600">Simulated Latency:</span>
                <span class="font-bold text-ink">~600ms typing latency</span>
              </div>
            </div>
          </div>

          <div class="card shadow-[4px_4px_0px_0px_rgba(32,30,29,1)]">
            <h3 class="text-lg font-extrabold font-heading text-ink mb-3 flex items-center gap-2">
              🚀 Backend Implementation Roadmap
            </h3>
            <p class="text-xs text-neutral-700 leading-relaxed mb-4">
              Following UI prototyping, backend engineering will proceed according to the roadmap below:
            </p>

            <ol class="relative border-l-2 border-ink ml-3 space-y-4 text-xs">
              <li class="pl-4 relative">
                <span class="absolute -left-[9px] top-0.5 w-4 h-4 rounded-full bg-accent border-2 border-ink flex items-center justify-center text-[9px] font-bold text-bg">1</span>
                <strong class="font-extrabold text-ink block">UI/UX Prototype Complete (Current)</strong>
                <span class="text-neutral-600">Floating widget, sandbox page demo, gathering interface feedback.</span>
              </li>
              <li class="pl-4 relative">
                <span class="absolute -left-[9px] top-0.5 w-4 h-4 rounded-full bg-white border-2 border-ink flex items-center justify-center text-[9px] font-bold text-ink">2</span>
                <strong class="font-extrabold text-ink block">Knowledge Base & Vector Indexing</strong>
                <span class="text-neutral-600">Indexing site content, blog posts, project specs into vector embeddings.</span>
              </li>
              <li class="pl-4 relative">
                <span class="absolute -left-[9px] top-0.5 w-4 h-4 rounded-full bg-white border-2 border-ink flex items-center justify-center text-[9px] font-bold text-ink">3</span>
                <strong class="font-extrabold text-ink block">Serverless API Endpoint</strong>
                <span class="text-neutral-600">FastAPI / Cloudflare Workers backend service for streaming RAG.</span>
              </li>
            </ol>
          </div>

          <div class="card bg-surface shadow-[4px_4px_0px_0px_rgba(32,30,29,1)]">
            <h3 class="text-sm font-extrabold font-heading text-ink mb-2">
              💡 Prototype UI Feedback
            </h3>
            <p class="text-xs text-neutral-600 leading-relaxed mb-3">
              Have suggestions or feature requests for this AI Assistant? Reach out directly!
            </p>
            <a href="/en/contact" class="btn-secondary w-full py-2 text-xs font-mono text-center block">
              Send Feedback
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const fullMessages = document.getElementById('full-chat-messages');
    const fullForm = document.getElementById('full-chat-form');
    const fullInput = document.getElementById('full-chat-input') as HTMLInputElement | null;
    const fullResetBtn = document.getElementById('full-chat-reset');
    const fullChips = document.querySelectorAll('.full-chip');

    const FULL_WELCOME = {
      sender: 'assistant',
      text: `Welcome to the **Behitek AI Assistant Sandbox**! 🚀<br/><br/>
      Test out prompt suggestions below or enter any query to experience the prototype interaction flow.`,
      time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };

    let history: any[] = [FULL_WELCOME];

    function renderFull() {
      if (!fullMessages) return;
      fullMessages.innerHTML = '';

      history.forEach((msg) => {
        const isUser = msg.sender === 'user';
        const wrap = document.createElement('div');
        wrap.className = `flex flex-col ${isUser ? 'items-end' : 'items-start'} max-w-[85%] ${isUser ? 'ml-auto' : 'mr-auto'}`;

        const meta = document.createElement('div');
        meta.className = 'font-mono text-[11px] text-neutral-500 mb-1';
        meta.innerHTML = isUser ? `<span>You</span> • ${msg.time}` : `<span class="text-accent font-bold">Behitek AI Assistant [Demo]</span> • ${msg.time}`;

        const box = document.createElement('div');
        box.className = isUser
          ? 'bg-ink text-bg p-3.5 border-2 border-ink text-sm shadow-[2px_2px_0px_0px_rgba(236,48,19,1)]'
          : 'bg-white text-ink p-3.5 border-2 border-ink text-sm shadow-[2px_2px_0px_0px_rgba(32,30,29,1)] leading-relaxed';
        box.innerHTML = msg.text;

        wrap.appendChild(meta);
        wrap.appendChild(box);
        fullMessages.appendChild(wrap);
      });

      fullMessages.scrollTop = fullMessages.scrollHeight;
    }

    function sendFull(text: string) {
      if (!text.trim()) return;
      const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      history.push({ sender: 'user', text, time: now });
      renderFull();
      if (fullInput) fullInput.value = '';

      setTimeout(() => {
        let reply = '';
        const lower = text.toLowerCase();
        if (lower.includes('introduce') || lower.includes('behitek')) {
          reply = `<strong>Behitek</strong> is an AI engineering studio founded by <strong>Hieu Nguyen</strong>.<br/>Our mission is bringing advanced AI (RAG, Agents, NLP) into production systems.`;
        } else if (lower.includes('consulting') || lower.includes('process')) {
          reply = `<strong>AI Consulting Workflow:</strong><br/>
          1. Technical feasibility & problem scoping.<br/>
          2. Rapid PoC / UI Prototype.<br/>
          3. RAG/LLM backend architecture & vector indexing.<br/>
          4. Performance benchmarking & production deployment.`;
        } else {
          reply = `Thank you for testing with message: <em>"${text}"</em>.<br/>
          ⚡ This is a prototype UI response. Backend API integration will follow!`;
        }

        history.push({ sender: 'assistant', text: reply, time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) });
        renderFull();
      }, 600);
    }

    fullForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (fullInput) sendFull(fullInput.value);
    });

    fullChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const prompt = chip.getAttribute('data-prompt');
        if (prompt) sendFull(prompt);
      });
    });

    fullResetBtn?.addEventListener('click', () => {
      history = [FULL_WELCOME];
      renderFull();
    });

    renderFull();
  </script>
</BaseLayout>
