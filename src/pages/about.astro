---
import BaseLayout from '@layouts/BaseLayout.astro';
import Timeline from '@components/Timeline.astro';
import AwardsList from '@components/AwardsList.astro';
import { SOCIAL_LINKS } from '@utils/constants';

const SKILLS = [
  'LLM',
  'RAG',
  'NLP',
  'Agentic AI',
  'Python',
  'FastAPI',
  'Docker',
  'Kubernetes',
  'PostgreSQL',
  'Redis',
];

const TIMELINE = [
  {
    years: '2023 — nay',
    role: 'AI Engineer — VMO',
    description:
      'Xây dựng sản phẩm AI fullstack, thiết kế kiến trúc giải pháp, tham gia bidding và dẫn dắt một nhóm kỹ sư nhỏ.',
    dotAccent: true,
  },
  {
    years: '2019 — 2022',
    role: 'AI Engineer — Zalo',
    description:
      'Speech cho Zalo & trợ lý ảo KiKi: text normalization, +12% độ chính xác ASR, −15% lỗi dịch vụ trên Kubernetes.',
  },
  {
    years: '2020 — 2022',
    role: 'Thạc sĩ KH Thông tin — JAIST, Nhật Bản',
    description: 'Information retrieval & machine learning.',
  },
  {
    years: '2018 — 2019',
    role: 'AI Engineer — VCCorp',
    description: 'Hệ thống lọc bình luận spam bằng NLP.',
  },
];

const AWARDS = [
  'Champion — AI4VN National Grand Finale Hackathon',
  'Giải Nhất — ALQAC (Legal Document Retrieval)',
  'Giải Nhì — ACM/ICPC Việt Nam National Contest',
  'Giải Nhì — Speech-to-Text Shared Task, VLSP 2019',
];
---

<BaseLayout
  title="Giới thiệu"
  description="Hiếu Nguyễn — AI Engineer tại Hà Nội, 8 năm kinh nghiệm."
>
  <div class="rgrid grid grid-cols-[380px_1fr]">
    <div class="rpad border-r-2 border-ink px-12 py-12">
      <img
        src="/images/me.png"
        alt="Hiếu Nguyễn"
        class="grayscale-photo mb-5 block h-[180px] w-[180px] border-2 border-ink object-cover"
      />
      <h1 class="mb-1 font-heading text-[34px] font-extrabold text-ink">Hiếu Nguyễn</h1>
      <div class="mb-4.5 font-heading text-[15px] font-bold text-accent">AI Engineer · Hà Nội</div>
      <div class="flex flex-col font-mono text-[13px] leading-[2.1] text-ink">
        <a href={SOCIAL_LINKS.email.href}>hello@behitek.com</a>
        <a href={SOCIAL_LINKS.github.href} target="_blank" rel="noopener noreferrer"
          >github.com/behitek</a
        >
        <a href={SOCIAL_LINKS.linkedin.href} target="_blank" rel="noopener noreferrer"
          >linkedin.com/in/behitek</a
        >
      </div>
      <div class="my-5 h-0.5 bg-ink"></div>
      <div class="mb-3 font-mono text-[11px] font-semibold tracking-[0.08em] text-neutral-600">
        KỸ NĂNG
      </div>
      <div class="flex flex-wrap gap-1.5">
        {SKILLS.map((s) => <span class="tag-pill text-[11.5px]">{s}</span>)}
      </div>
      <div class="my-5 h-0.5 bg-ink"></div>
      <div class="mb-3 font-mono text-[11px] font-semibold tracking-[0.08em] text-neutral-600">
        NGÔN NGỮ
      </div>
      <div class="text-[13.5px] leading-[1.9] text-ink">
        Tiếng Việt (bản ngữ)<br />
        English (professional)
      </div>
    </div>

    <div class="p-12">
      <div class="kicker mb-5">$ cat experience.log</div>
      <Timeline entries={TIMELINE} />

      <div class="kicker mb-4 mt-6">$ cat awards.log</div>
      <AwardsList awards={AWARDS} />
    </div>
  </div>
</BaseLayout>
