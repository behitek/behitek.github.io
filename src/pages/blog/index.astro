---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogCard from '@components/BlogCard.astro';
import { readingTime } from '@utils/helpers';
import { useTranslations } from '@/i18n/ui';

const lang = 'vi';
const t = useTranslations(lang);

const allPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const languages = [...new Set(sortedPosts.map((post) => post.data.language))];
const categories = [...new Set(sortedPosts.map((post) => post.data.category))];

const filters = [
  { key: 'all', label: 'tất cả', count: sortedPosts.length },
  ...languages.map((l) => ({
    key: `lang-${l}`,
    label: l === 'vi' ? 'lang:vi' : 'lang:en',
    count: sortedPosts.filter((p) => p.data.language === l).length,
  })),
  ...categories.map((cat) => ({
    key: `cat-${cat.toLowerCase().replace(/\//g, '-')}`,
    label: cat.toLowerCase(),
    count: sortedPosts.filter((p) => p.data.category === cat).length,
  })),
];
---

<BaseLayout title={t('blog.meta_title')} description={t('blog.meta_desc')} lang={lang}>
  <div class="px-6 lg:px-12 pt-10 lg:pt-14 pb-6">
    <div class="kicker mb-3.5">$ ls ./blog | sort -r</div>
    <h1 class="font-heading font-extrabold text-[36px] sm:text-[48px] text-ink mb-6">{t('blog.title')}</h1>
    <div class="flex flex-wrap border-2 border-ink w-fit" id="blog-filters">
      {
        filters.map((f, i) => (
          <button
            type="button"
            class={`filter-btn font-mono text-xs font-semibold px-4 py-2 cursor-pointer bg-transparent text-ink hover:text-accent ${i > 0 ? 'border-l border-border-light' : ''} ${
              f.key === 'all' ? 'active' : ''
            }`}
            data-filter={f.key}
          >
            {f.label} ({f.count})
          </button>
        ))
      }
    </div>
  </div>

  <div class="px-6 lg:px-12 pb-14">
    <div class="border-t-2 border-ink" id="posts-list">
      {
        sortedPosts.map((post) => (
          <div
            class="blog-post-item"
            data-lang={post.data.language}
            data-category={post.data.category.toLowerCase().replace(/\//g, '-')}
          >
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
              language={post.data.language}
              slug={post.id}
              readingTime={readingTime(post.body ?? '')}
              lang={lang}
            />
          </div>
        ))
      }
    </div>
    <div id="empty-state" class="hidden text-center py-16">
      <p class="text-lg text-neutral-600 mb-4">Không có bài viết phù hợp bộ lọc.</p>
      <button id="reset-filters" class="link text-base">Xoá bộ lọc</button>
    </div>
  </div>
</BaseLayout>

<style>
  .filter-btn.active {
    @apply bg-ink text-bg;
  }
  .filter-btn.active:hover {
    @apply text-bg;
  }
</style>

<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const postItems = document.querySelectorAll('.blog-post-item');
  const emptyState = document.getElementById('empty-state');
  const postsList = document.getElementById('posts-list');
  const resetButton = document.getElementById('reset-filters');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter') || 'all';

      filterButtons.forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');

      let visibleCount = 0;

      postItems.forEach((item) => {
        let visible = filter === 'all';
        if (filter.startsWith('lang-')) {
          visible = item.getAttribute('data-lang') === filter.replace('lang-', '');
        } else if (filter.startsWith('cat-')) {
          visible = item.getAttribute('data-category') === filter.replace('cat-', '');
        }

        if (visible) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        postsList?.classList.add('hidden');
        emptyState?.classList.remove('hidden');
      } else {
        postsList?.classList.remove('hidden');
        emptyState?.classList.add('hidden');
      }
    });
  });

  resetButton?.addEventListener('click', () => {
    (document.querySelector('[data-filter="all"]') as HTMLButtonElement)?.click();
  });
</script>
