---
import { SOCIAL_LINKS } from '@utils/constants';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'vi' } = Astro.props;
const currentYear = new Date().getFullYear();
const homeHref = lang === 'en' ? '/en' : '/';

const FOOTER_LINKS = [
  { label: 'GitHub', href: SOCIAL_LINKS.github.href },
  { label: 'LinkedIn', href: SOCIAL_LINKS.linkedin.href },
  { label: 'X', href: SOCIAL_LINKS.twitter.href },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="rwrap rpad mt-auto flex items-center justify-between gap-5 px-6 md:px-12 py-6 bg-ink">
  <a href={homeHref} class="font-heading font-extrabold text-base text-bg no-underline"
    >behitek<span class="text-accent">_</span></a
  >
  <div class="flex gap-[22px] font-mono text-xs">
    {
      FOOTER_LINKS.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('/') ? undefined : '_blank'}
          rel={link.href.startsWith('/') ? undefined : 'noopener noreferrer'}
          class="text-border-light no-underline hover:text-accent"
        >
          {link.label}
        </a>
      ))
    }
  </div>
  <div class="font-mono text-xs text-neutral-600">© {currentYear} behitek.com</div>
</footer>
