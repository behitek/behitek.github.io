---
import type { Lang } from '@/i18n/ui';

interface Props {
  active: 'online-judge' | 'ai' | 'software';
  lang?: Lang;
}

const { active, lang = 'vi' } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const TABS = [
  { id: 'online-judge', label: 'online-judge', href: `${prefix}/services` },
  { id: 'ai', label: lang === 'en' ? 'AI projects' : 'dự án AI', href: `${prefix}/services/ai` },
  { id: 'software', label: lang === 'en' ? 'software' : 'phần mềm', href: `${prefix}/services/software` },
] as const;
---

<div class="px-6 lg:px-12 pt-8">
  <div class="flex border-2 border-ink w-fit">
    {
      TABS.map((tab, i) => (
        <a
          href={tab.href}
          class={`font-mono text-xs font-semibold px-4 py-2 no-underline hover:text-accent ${i > 0 ? 'border-l border-border-light' : ''} ${
            active === tab.id ? 'bg-ink text-bg' : 'text-ink'
          }`}
        >
          {tab.label}
        </a>
      ))
    }
  </div>
</div>
