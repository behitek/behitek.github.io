---
// ChatWidget.astro - Clean Modern AI Assistant Widget for Behitek
---

<!-- Floating AI Chatbot Launcher Container -->
<div id="ai-chat-widget-container" class="fixed bottom-6 right-6 z-50 flex flex-col items-end">
  
  <!-- Sleek Greeting Speech Callout Bubble -->
  <div
    id="ai-chat-bubble"
    class="mb-3 bg-ink text-bg px-3.5 py-2 border-2 border-ink shadow-[4px_4px_0px_0px_rgba(236,48,19,1)] text-xs font-sans flex items-center gap-2 max-w-[250px] transition-all duration-300 relative"
  >
    <span class="w-2 h-2 shrink-0 bg-green-500 animate-pulse" style="border-radius: 9999px;"></span>
    <span class="text-neutral-200">Bạn cần tư vấn giải pháp AI hay dịch vụ từ Behitek?</span>
    <button
      id="ai-bubble-close"
      type="button"
      class="text-neutral-400 hover:text-white font-bold ml-1 text-xs"
      aria-label="Đóng gợi ý"
    >
      ✕
    </button>
    <!-- Pointer Arrow -->
    <div class="absolute -bottom-2 right-6 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[8px] border-t-ink"></div>
  </div>

  <!-- Launcher Button (Popular Brand Chatbot Style) -->
  <button
    id="ai-chat-toggle-btn"
    type="button"
    class="relative group flex items-center gap-2.5 bg-ink hover:bg-accent text-bg px-4 py-3 border-2 border-ink shadow-[4px_4px_0px_0px_rgba(32,30,29,1)] transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
    aria-label="Mở Behitek AI Assistant"
  >
    <!-- Green Live Online Status Dot -->
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full bg-green-400 opacity-75" style="border-radius: 9999px;"></span>
      <span class="relative inline-flex h-2.5 w-2.5 bg-green-500" style="border-radius: 9999px;"></span>
    </span>

    <!-- Modern Chatbot Sparkle Icon -->
    <div id="ai-toggle-icon" class="w-4 h-4 flex items-center justify-center transition-transform duration-300">
      <svg class="w-4.5 h-4.5 fill-current text-bg group-hover:text-bg transition-colors" viewBox="0 0 24 24">
        <path d="M12 2C6.477 2 2 6.141 2 11.25c0 2.458 1.05 4.675 2.768 6.276L4 21l3.854-1.285A10.22 10.22 0 0012 20.5c5.523 0 10-4.141 10-9.25S17.523 2 12 2zm1 11.5h-2v-2h2v2zm0-4h-2V6.5h2v3z" />
      </svg>
    </div>

    <span class="font-heading font-extrabold text-xs tracking-wider">
      Behitek AI
    </span>
  </button>
</div>

<!-- Chat Window Modal -->
<div
  id="ai-chat-window"
  class="fixed bottom-24 right-4 sm:right-6 w-[calc(100vw-2rem)] sm:w-[400px] h-[580px] max-h-[82vh] bg-white border-2 border-ink shadow-[8px_8px_0px_0px_rgba(32,30,29,1)] z-50 flex flex-col hidden transition-all duration-300 font-sans"
  aria-live="polite"
>
  <!-- Window Header -->
  <div class="flex items-center justify-between px-4 py-3 bg-ink text-bg border-b-2 border-ink">
    <div class="flex items-center gap-3">
      <!-- AI Avatar with Green Status Dot -->
      <div class="relative flex items-center justify-center w-8 h-8 bg-bg text-ink font-mono font-bold text-xs border border-ink">
        <svg class="w-4 h-4 fill-accent" viewBox="0 0 24 24">
          <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" />
        </svg>
        <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-green-500 border border-ink" style="border-radius: 9999px;"></span>
      </div>

      <div>
        <h3 class="font-heading font-extrabold text-sm text-bg leading-none">Behitek AI</h3>
        <p class="font-mono text-[10px] text-neutral-300 leading-tight mt-1 flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 bg-green-500" style="border-radius: 9999px;"></span> Online • Sẵn sàng hỗ trợ
        </p>
      </div>
    </div>

    <!-- Header Actions -->
    <div class="flex items-center gap-1.5">
      <a
        href="/assistant"
        title="Mở toàn màn hình"
        class="text-neutral-300 hover:text-white font-mono text-xs p-1 hover:bg-neutral-800 transition-colors"
      >
        ↗ Fullscreen
      </a>
      <button
        id="ai-clear-btn"
        type="button"
        title="Xóa trò chuyện"
        class="text-neutral-300 hover:text-accent p-1 text-xs font-mono transition-colors"
      >
        🗑️
      </button>
      <button
        id="ai-chat-close-btn"
        type="button"
        class="text-neutral-300 hover:text-accent font-bold text-base px-2 py-0.5 hover:bg-neutral-800 transition-colors"
        aria-label="Đóng chat"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Subtle Prototype Notice inside Modal -->
  <div class="bg-surface border-b border-ink px-3 py-1.5 flex items-center justify-between text-[11px] text-ink font-mono">
    <div class="flex items-center gap-1.5">
      <span class="w-2 h-2 bg-green-500" style="border-radius: 9999px;"></span>
      <span class="text-neutral-700">Trợ lý AI hỗ trợ tự động</span>
    </div>
    <span class="bg-accent-100 text-accent px-1.5 py-0.5 text-[9px] font-bold border border-accent">PROTOTYPE</span>
  </div>

  <!-- Messages Container -->
  <div id="ai-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-bg text-sm">
    <!-- Initial welcome message rendered dynamically via JS -->
  </div>

  <!-- Quick Prompts Chips Container -->
  <div id="ai-chat-suggestions" class="px-3 py-2 bg-surface border-t border-ink/20 flex flex-wrap gap-1.5">
    <button type="button" class="ai-chip tag-pill bg-white hover:bg-accent hover:text-white transition-colors cursor-pointer" data-prompt="Behitek là ai và làm việc gì?">
      💡 Behitek là ai?
    </button>
    <button type="button" class="ai-chip tag-pill bg-white hover:bg-accent hover:text-white transition-colors cursor-pointer" data-prompt="Các dịch vụ AI & phần mềm của Behitek?">
      💼 Dịch vụ AI & Software
    </button>
    <button type="button" class="ai-chip tag-pill bg-white hover:bg-accent hover:text-white transition-colors cursor-pointer" data-prompt="Tôi muốn tư vấn & báo giá dự án AI">
      🚀 Tư vấn báo giá
    </button>
    <button type="button" class="ai-chip tag-pill bg-white hover:bg-accent hover:text-white transition-colors cursor-pointer" data-prompt="Phương thức liên hệ trực tiếp">
      📞 Liên hệ
    </button>
  </div>

  <!-- Typing Indicator -->
  <div id="ai-typing-indicator" class="hidden px-4 py-2 bg-bg text-xs font-mono text-neutral-600 flex items-center gap-2 border-t border-dashed border-ink/20">
    <span class="inline-block w-2 h-2 bg-green-500 animate-bounce" style="border-radius: 9999px;"></span>
    <span class="inline-block w-2 h-2 bg-green-500 animate-bounce [animation-delay:0.2s]" style="border-radius: 9999px;"></span>
    <span class="inline-block w-2 h-2 bg-green-500 animate-bounce [animation-delay:0.4s]" style="border-radius: 9999px;"></span>
    <span class="italic text-neutral-500">Behitek AI đang soạn câu trả lời...</span>
  </div>

  <!-- Input Form -->
  <form id="ai-chat-form" class="p-3 bg-white border-t-2 border-ink flex items-center gap-2">
    <input
      id="ai-chat-input"
      type="text"
      placeholder="Hỏi câu hỏi bất kỳ về Behitek..."
      class="flex-1 bg-bg border border-ink px-3 py-2.5 text-sm text-ink focus:outline-none focus:border-accent font-sans placeholder:text-neutral-400 placeholder:text-xs"
      autocomplete="off"
    />

    <button
      type="submit"
      class="btn-primary py-2.5 px-4 text-xs flex items-center gap-1 shrink-0"
    >
      <span>Gửi</span>
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
      </svg>
    </button>
  </form>
</div>

<script>
  const toggleBtn = document.getElementById('ai-chat-toggle-btn');
  const toggleIcon = document.getElementById('ai-toggle-icon');
  const closeBtn = document.getElementById('ai-chat-close-btn');
  const chatWindow = document.getElementById('ai-chat-window');
  const speechBubble = document.getElementById('ai-chat-bubble');
  const bubbleClose = document.getElementById('ai-bubble-close');
  const messagesContainer = document.getElementById('ai-chat-messages');
  const chatForm = document.getElementById('ai-chat-form');
  const chatInput = document.getElementById('ai-chat-input') as HTMLInputElement | null;
  const typingIndicator = document.getElementById('ai-typing-indicator');
  const clearBtn = document.getElementById('ai-clear-btn');
  const chips = document.querySelectorAll('.ai-chip');

  bubbleClose?.addEventListener('click', (e) => {
    e.stopPropagation();
    speechBubble?.classList.add('hidden');
  });

  const KNOWLEDGE_BASE: Record<string, string> = {
    'behitek là ai': `<strong>Behitek</strong> là studio giải pháp AI & Phần mềm của <strong>Hieu Nguyen</strong> — chuyên xây dựng và đưa các ứng dụng trí tuệ nhân tạo (LLM, RAG, Computer Vision) vào ứng dụng thương mại thực tế.<br/><br/>👉 Xem thêm tại trang <a href="/about" class="text-accent underline font-bold">Về Behitek</a> hoặc các <a href="/projects" class="text-accent underline font-bold">Dự án tiêu biểu</a>.`,
    
    'dịch vụ': `Behitek cung cấp 3 dịch vụ cốt lõi:<br/>
    🔹 <strong>AI Solution Consulting:</strong> Tư vấn kiến trúc RAG, Fine-tuning LLM & tích hợp AI Agent.<br/>
    🔹 <strong>Full-stack Web & Systems:</strong> Phát triển ứng dụng Web tốc độ cao (Astro, React, Python, Node.js).<br/>
    🔹 <strong>MLOps & Cloud Deployment:</strong> Triển khai hạ tầng AI trên Docker, Cloud/On-premise.<br/><br/>
    👉 Khám phá chi tiết tại <a href="/services" class="text-accent underline font-bold">Trang Dịch Vụ</a>.`,

    'báo giá': `Chi phí dự án được xây dựng linh hoạt theo từng bài toán:<br/>
    • <strong>Fixed-price (Trọn gói):</strong> Phù hợp cho PoC / MVP / Dự án rõ Scope.<br/>
    • <strong>Time & Materials (Theo giờ/tháng):</strong> Phù hợp phát triển tính năng liên tục.<br/><br/>
    📩 Hãy để lại thông tin tại <a href="/contact" class="text-accent underline font-bold">Trang Liên Hệ</a> để nhận báo giá chi tiết trong 24h!`,

    'liên hệ': `Bạn có thể kết nối trực tiếp với <strong>Behitek</strong> qua:<br/>
    • 📧 Email: <a href="mailto:hello@behitek.com" class="text-accent underline font-bold">hello@behitek.com</a><br/>
    • 💼 LinkedIn: <a href="https://www.linkedin.com/in/behitek/" target="_blank" class="text-accent underline">linkedin.com/in/behitek</a><br/>
    • 💻 GitHub: <a href="https://github.com/behitek" target="_blank" class="text-accent underline">github.com/behitek</a>`
  };

  const WELCOME_MSG = {
    sender: 'assistant',
    text: `Xin chào! 👋 Tôi là **Behitek AI Assistant**.<br/><br/>
    Tôi sẵn sàng giải đáp thắc mắc về các giải pháp AI, dịch vụ phần mềm và quy trình làm việc của Behitek.<br/><br/>
    <span class="inline-block bg-accent-100 text-accent font-mono text-[11px] px-2 py-1 border border-accent">
      💡 Chọn chủ đề gợi ý bên dưới để tìm hiểu nhanh!
    </span>`,
    time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
  };

  const STORAGE_KEY = 'behitek_ai_chat_v3';

  function loadHistory() {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try { return JSON.parse(saved); } catch (e) {}
    }
    return [WELCOME_MSG];
  }

  function saveHistory(msgs: any[]) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(msgs));
  }

  let chatHistory = loadHistory();

  function renderMessages() {
    if (!messagesContainer) return;
    messagesContainer.innerHTML = '';

    chatHistory.forEach((msg: any) => {
      const isUser = msg.sender === 'user';
      const wrapper = document.createElement('div');
      wrapper.className = `flex flex-col ${isUser ? 'items-end' : 'items-start'} max-w-[92%] ${isUser ? 'ml-auto' : 'mr-auto'}`;

      const meta = document.createElement('div');
      meta.className = 'flex items-center gap-1.5 mb-1 font-mono text-[10px] text-neutral-500';
      meta.innerHTML = isUser
        ? `<span>Bạn</span> • <span>${msg.time || ''}</span>`
        : `<span class="text-accent font-bold">Behitek AI</span> • <span>${msg.time || ''}</span>`;

      const card = document.createElement('div');
      card.className = isUser
        ? 'bg-ink text-bg p-3 border-2 border-ink text-sm shadow-[2px_2px_0px_0px_rgba(236,48,19,1)]'
        : 'bg-white text-ink p-3 border-2 border-ink text-sm shadow-[3px_3px_0px_0px_rgba(32,30,29,1)] leading-relaxed relative group';
      card.innerHTML = msg.text;

      if (!isUser) {
        const copyBtn = document.createElement('button');
        copyBtn.className = 'absolute top-1 right-1 opacity-0 group-hover:opacity-100 transition-opacity bg-surface hover:bg-neutral-200 border border-ink text-[10px] font-mono px-1.5 py-0.5 text-ink';
        copyBtn.innerText = '📋 Copy';
        copyBtn.onclick = () => {
          navigator.clipboard.writeText(card.innerText);
          copyBtn.innerText = '✓ Copied';
          setTimeout(() => copyBtn.innerText = '📋 Copy', 1500);
        };
        card.appendChild(copyBtn);
      }

      wrapper.appendChild(meta);
      wrapper.appendChild(card);
      messagesContainer.appendChild(wrapper);
    });

    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  toggleBtn?.addEventListener('click', () => {
    if (!chatWindow) return;
    const isHidden = chatWindow.classList.contains('hidden');
    speechBubble?.classList.add('hidden');

    if (isHidden) {
      chatWindow.classList.remove('hidden');
      if (toggleIcon) toggleIcon.innerHTML = `<span class="font-bold text-sm">✕</span>`;
      renderMessages();
      chatInput?.focus();
    } else {
      chatWindow.classList.add('hidden');
      if (toggleIcon) {
        toggleIcon.innerHTML = `<svg class="w-4.5 h-4.5 fill-current text-bg group-hover:text-bg transition-colors" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.141 2 11.25c0 2.458 1.05 4.675 2.768 6.276L4 21l3.854-1.285A10.22 10.22 0 0012 20.5c5.523 0 10-4.141 10-9.25S17.523 2 12 2zm1 11.5h-2v-2h2v2zm0-4h-2V6.5h2v3z"/></svg>`;
      }
    }
  });

  closeBtn?.addEventListener('click', () => {
    chatWindow?.classList.add('hidden');
    if (toggleIcon) {
      toggleIcon.innerHTML = `<svg class="w-4.5 h-4.5 fill-current text-bg group-hover:text-bg transition-colors" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.141 2 11.25c0 2.458 1.05 4.675 2.768 6.276L4 21l3.854-1.285A10.22 10.22 0 0012 20.5c5.523 0 10-4.141 10-9.25S17.523 2 12 2zm1 11.5h-2v-2h2v2zm0-4h-2V6.5h2v3z"/></svg>`;
    }
  });

  function handleSend(userText: string) {
    if (!userText.trim()) return;

    const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    chatHistory.push({ sender: 'user', text: userText, time });
    saveHistory(chatHistory);
    renderMessages();

    if (chatInput) chatInput.value = '';

    typingIndicator?.classList.remove('hidden');
    if (messagesContainer) messagesContainer.scrollTop = messagesContainer.scrollHeight;

    setTimeout(() => {
      typingIndicator?.classList.add('hidden');

      let reply = '';
      const lower = userText.toLowerCase();
      let matchedKey = Object.keys(KNOWLEDGE_BASE).find(k => lower.includes(k));

      if (matchedKey) {
        reply = KNOWLEDGE_BASE[matchedKey];
      } else {
        reply = `Cảm ơn bạn đã nhắn: <em>"${userText}"</em>.<br/><br/>
        🤖 <strong>Hệ thống AI Demo:</strong> Trợ lý đang hoạt động ở bản giao diện PoC.<br/>
        Ở phiên bản tiếp theo, AI sẽ được đấu nối trực tiếp với LLM backend để giải đáp thông minh mọi câu hỏi của bạn.<br/><br/>
        📌 Bạn có thể gửi phản hồi trực tiếp qua trang <a href="/contact" class="text-accent underline font-bold">Liên Hệ</a>!`;
      }

      chatHistory.push({
        sender: 'assistant',
        text: reply,
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      });

      saveHistory(chatHistory);
      renderMessages();
    }, 700);
  }

  chatForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (chatInput) handleSend(chatInput.value);
  });

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const prompt = chip.getAttribute('data-prompt');
      if (prompt) handleSend(prompt);
    });
  });

  clearBtn?.addEventListener('click', () => {
    if (confirm('Bạn có muốn xóa lịch sử cuộc trò chuyện không?')) {
      chatHistory = [WELCOME_MSG];
      saveHistory(chatHistory);
      renderMessages();
    }
  });

  renderMessages();
</script>
