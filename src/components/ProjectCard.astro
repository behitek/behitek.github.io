---
import ImageGallery from '@components/ImageGallery.astro';
import ProjectPlaceholderGraphic from '@components/ProjectPlaceholderGraphic.astro';

interface Props {
  title: string;
  description: string;
  tech: string[];
  image?: string;
  images?: string[];
  links?: {
    website?: string;
    github?: string;
    blog?: string;
  };
  status: 'open-source' | 'private';
  flagship?: boolean;
  id: string;
}

const { title, description, tech, image, images, links, status, flagship, id } = Astro.props;
const hasLinks = links && (links.website || links.github || links.blog);
const statusLabel = status === 'open-source' ? 'OPEN SOURCE' : 'PRIVATE';
const heroImage = image || (images && images[0]);
---

<article
  class="rgrid grid grid-cols-[440px_1fr] border-2 border-ink bg-white"
  style={flagship ? 'border-top-width:4px;border-top-color:#ec3013' : ''}
>
  <div class="relative border-r-2 border-ink min-h-[240px]">
    {
      heroImage ? (
        <img src={heroImage} alt={title} class="w-full h-full object-cover grayscale-photo" />
      ) : (
        <ProjectPlaceholderGraphic title={title} />
      )
    }
  </div>

  <div class="p-7 md:p-8">
    <div class="flex gap-2.5 mb-3">
      <span class="font-mono text-[10px] font-semibold bg-accent text-bg px-[7px] py-[3px]">SẢN PHẨM</span>
      <span class="font-mono text-[10px] font-semibold border border-ink text-ink px-[7px] py-0.5"
        >{statusLabel}</span
      >
    </div>

    <h2 class="text-2xl md:text-[26px] font-heading font-extrabold text-ink mb-2">
      {
        images && images.length > 0 ? (
          <button
            type="button"
            class="text-left bg-transparent border-0 p-0 cursor-pointer font-heading font-extrabold text-2xl md:text-[26px] text-ink hover:text-accent"
            onclick={`openImageGallery('${id}', 0)`}
          >
            {title}
          </button>
        ) : (
          title
        )
      }
    </h2>

    <p class="text-[14.5px] leading-relaxed text-neutral-700 mb-4">{description}</p>

    {images && images.length > 0 && <ImageGallery images={images} title={title} projectId={id} />}

    <div class="flex flex-wrap gap-2 mb-4">
      {tech.map((t) => <span class="tag-pill">{t}</span>)}
    </div>

    {
      hasLinks && (
        <div class="flex items-center gap-4 font-mono text-[13px] font-semibold">
          {links.website && (
            <a href={links.website} target="_blank" rel="noopener noreferrer" class="text-accent no-underline">
              Website →
            </a>
          )}
          {links.github && (
            <a href={links.github} target="_blank" rel="noopener noreferrer" class="text-ink no-underline hover:text-accent">
              GitHub →
            </a>
          )}
          {links.blog && (
            <a href={links.blog} class="text-ink no-underline hover:text-accent">
              Đọc thêm →
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
