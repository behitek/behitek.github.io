---
interface Heading {
  slug: string;
  text: string;
  depth: number;
}

interface Props {
  headings: Heading[];
  variant?: 'desktop' | 'mobile' | 'both';
}

const { headings, variant = 'both' } = Astro.props;
const showMobile = variant === 'mobile' || variant === 'both';
const showDesktop = variant === 'desktop' || variant === 'both';
---

{
  headings.length > 0 && (
    <>
      {/* Mobile Collapsible TOC (shows on screens < lg) */}
      {showMobile && (
        <details class="mb-8 border-2 border-ink bg-surface p-4 lg:hidden">
          <summary class="flex cursor-pointer items-center justify-between font-mono text-xs font-bold text-ink">
            <span>📋 MỤC LỤC BÀI VIẾT ({headings.length})</span>
            <span class="text-neutral-500">▼</span>
          </summary>
          <ul class="mt-4 flex flex-col gap-2 border-t border-border-light pt-3 font-sans text-sm list-none m-0 p-0">
            {headings.map((heading) => (
              <li style={`margin-left: ${(heading.depth - 2) * 0.75}rem`}>
                <a
                  href={`#${heading.slug}`}
                  class="toc-link block py-1 text-neutral-700 no-underline hover:text-accent"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}

      {/* Desktop Sticky TOC (shows on lg and up) */}
      {showDesktop && (
        <nav class="toc hidden lg:block sticky top-24">
          <div class="mb-3.5 font-mono text-[11px] font-semibold tracking-[0.08em] text-neutral-600">
            MỤC LỤC
          </div>
          <ul class="m-0 flex flex-col gap-2.5 p-0 pr-4 font-sans text-sm list-none">
            {headings.map((heading) => (
              <li style={`margin-left: ${(heading.depth - 2) * 0.75}rem`}>
                <a
                  href={`#${heading.slug}`}
                  class="toc-link -ml-2.5 block border-l-2 border-transparent py-0 pl-2.5 text-neutral-700 no-underline transition-colors hover:text-accent"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </>
  )
}

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute('id');
        const tocLinks = document.querySelectorAll(`.toc-link[href="#${id}"]`);

        if (entry.isIntersecting) {
          document.querySelectorAll('.toc-link').forEach((link) => {
            link.classList.remove('text-accent', 'border-accent', 'font-semibold');
            link.classList.add('text-neutral-700', 'border-transparent');
          });
          tocLinks.forEach((link) => {
            link.classList.remove('text-neutral-700', 'border-transparent');
            link.classList.add('text-accent', 'border-accent', 'font-semibold');
          });
        }
      });
    },
    { rootMargin: '-100px 0px -66% 0px' }
  );

  document.querySelectorAll('h2, h3').forEach((heading) => {
    observer.observe(heading);
  });
</script>

<style>
  .toc {
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #d7d3d3 transparent;
  }

  .toc::-webkit-scrollbar {
    width: 4px;
  }

  .toc::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc::-webkit-scrollbar-thumb {
    background-color: #d7d3d3;
    border-radius: 2px;
  }

  .toc::-webkit-scrollbar-thumb:hover {
    background-color: #9b9797;
  }
</style>
