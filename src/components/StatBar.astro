---
const STATS = [
  { value: '7+', label: 'năm kinh nghiệm' },
  { value: '3', label: 'hệ thống OJ vận hành' },
  { value: '4', label: 'giải thưởng quốc gia' },
  { value: 'JAIST', label: 'Thạc sĩ KHTT, Nhật Bản' },
];
---

<div class="rgrid grid grid-cols-4 border-t-2 border-ink">
  {
    STATS.map((stat, i) => (
      <div class={`px-12 py-[22px] ${i < STATS.length - 1 ? 'border-r-2 border-ink' : ''}`}>
        <div class="font-heading font-extrabold text-[30px] text-ink">{stat.value}</div>
        <div class="font-mono text-xs text-neutral-600">{stat.label}</div>
      </div>
    ))
  }
</div>
