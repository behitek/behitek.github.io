---
import { TOTAL_PLATFORM_USERS } from '@/data/organizations';
import { getCompaniesShippedAt } from '@/data/ai-work';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'vi' } = Astro.props;
const t = useTranslations(lang);
const shipped = getCompaniesShippedAt(lang);

const STATS = [
  { value: t('stat.exp_val'), label: t('stat.exp_lbl') },
  { value: shipped.value, label: shipped.label },
  { value: t('stat.awards_val'), label: t('stat.awards_lbl') },
  { value: TOTAL_PLATFORM_USERS, label: t('stat.users_lbl') },
];
---

<div class="rgrid grid grid-cols-4 border-y-2 border-ink bg-white">
  {
    STATS.map((stat, i) => (
      <div
        class={`px-6 py-5 lg:px-12 lg:py-[22px] transition-colors hover:bg-neutral-50 ${
          i < STATS.length - 1 ? 'border-r-2 border-ink' : ''
        }`}
      >
        <div class="font-heading text-[28px] font-extrabold text-ink lg:text-[32px]">
          {stat.value}
        </div>
        <div class="font-mono text-xs leading-normal text-neutral-600">{stat.label}</div>
      </div>
    ))
  }
</div>
