---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  class="relative w-full h-full min-h-[240px] flex items-center justify-center overflow-hidden"
  style="background-image: repeating-linear-gradient(135deg, #ffe0d9 0px, #ffe0d9 12px, #f3f2f2 12px, #f3f2f2 24px);"
>
  <span class="font-mono text-xs font-semibold text-ink bg-bg border-2 border-ink px-3 py-1.5">
    {title}
  </span>
</div>
