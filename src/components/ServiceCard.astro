---
interface Props {
  href: string;
  path: string;
  title: string;
  description: string;
  bullets: string[];
  flagship?: boolean;
  borderRight?: boolean;
}

const { href, path, title, description, bullets, flagship = false, borderRight = true } = Astro.props;
---

<a
  href={href}
  class={`block p-7 bg-white no-underline hover:bg-neutral-100 ${borderRight ? 'border-r-2 border-ink' : ''} ${flagship ? 'border-t-4 border-t-accent' : ''}`}
>
  <div class="flex justify-between items-center mb-3">
    <span class="font-mono text-xs text-neutral-600">{path}</span>
    {flagship && <span class="font-mono text-[10px] font-semibold bg-accent text-bg px-[7px] py-[3px]">CHỦ LỰC</span>}
  </div>
  <h3 class="font-heading font-bold text-[21px] leading-tight text-ink mb-2.5">{title}</h3>
  <p class="text-sm leading-relaxed text-neutral-700 mb-4">{description}</p>
  <ul class="font-mono text-[13px] leading-[1.9] text-ink mb-4 pl-0 list-none">
    {bullets.map((b) => <li>› {b}</li>)}
  </ul>
  <div class="font-heading font-bold text-[13px] text-accent">Xem chi tiết →</div>
</a>
