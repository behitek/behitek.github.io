---
import { ORGANIZATIONS, DEPLOYMENTS, ORG_LIST_URL } from '@/data/organizations';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'vi' } = Astro.props;

const TIERS = [
  {
    kicker: lang === 'en' ? 'FREE SHARED PLATFORM' : 'MIỄN PHÍ, DÙNG CHUNG',
    title: lang === 'en' ? 'Organization on luyencode.net' : 'Tổ chức trên luyencode.net',
    price: lang === 'en' ? '$0 / Free' : '0đ',
    description:
      lang === 'en'
        ? 'Dedicated workspace on shared infrastructure for schools, clubs, and teams: student management, assignments, contest hosting. Zero server setup or maintenance required.'
        : 'Trường học, CLB và đội tuyển có không gian riêng trên nền tảng chung: quản lý học sinh, giao bài, tổ chức contest. Không cần máy chủ, không cần đội kỹ thuật.',
    proofLinks: [
      {
        label: lang === 'en' ? `${ORGANIZATIONS.length} schools & orgs using` : `${ORGANIZATIONS.length} trường & tổ chức đang dùng`,
        href: ORG_LIST_URL,
      },
    ],
    highlighted: true,
  },
  {
    kicker: lang === 'en' ? 'DEDICATED DEPLOYMENT' : 'TRIỂN KHAI RIÊNG',
    title: lang === 'en' ? 'Custom Domain, Dedicated VPS & Operation' : 'Tên miền, VPS, triển khai & vận hành',
    price: lang === 'en' ? 'Custom / Scale-based' : 'Theo quy mô',
    description:
      lang === 'en'
        ? 'Independent system on dedicated VPS infrastructure: domain consulting, installation, customization, backups, 24/7 monitoring and long-term maintenance.'
        : 'Hệ thống độc lập trên hạ tầng riêng (VPS) của đơn vị: tư vấn tên miền và máy chủ, cài đặt, tùy biến, backup, giám sát và hỗ trợ dài hạn. Không có sẵn ngân hàng đề của luyencode (đơn vị tự tạo đề hoặc dùng dịch vụ soạn đề bằng AI, chi phí thấp). Tổ chức giáo dục phi lợi nhuận chưa có kinh phí mua domain có thể dùng subdomain miễn phí trên luyencode.net.',
    proofLinks: DEPLOYMENTS.map((d) => ({ label: d.name, href: d.url })),
    highlighted: false,
  },
];
---

<div class="rgrid grid grid-cols-2 border-2 border-ink">
  {
    TIERS.map((tier, i) => (
      <div
        class={`flex flex-col bg-white p-7 ${i < TIERS.length - 1 ? 'border-r-2 border-ink' : ''} ${
          tier.highlighted ? 'border-t-4 border-t-accent' : ''
        }`}
      >
        <div class="mb-2.5 font-mono text-[11px] font-semibold tracking-[0.08em] text-neutral-600">
          {tier.kicker}
        </div>
        <h3 class="mb-1.5 font-heading text-xl font-bold leading-tight text-ink">{tier.title}</h3>
        <div class="mb-3.5 font-heading text-[22px] font-extrabold text-accent">{tier.price}</div>
        <p class="mb-5 text-[13.5px] leading-relaxed text-neutral-700">{tier.description}</p>
        <div class="mt-auto border-t-2 border-ink pt-3.5 font-mono text-[12px] leading-[1.6] text-neutral-600">
          {tier.proofLinks.map((link, j) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="no-underline hover:text-accent"
            >
              {`${link.label}${j < tier.proofLinks.length - 1 ? ', ' : ''}`}
            </a>
          ))}
        </div>
      </div>
    ))
  }
</div>
