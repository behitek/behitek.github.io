---
interface Props {
  kicker: string;
  title: string;
  description: string;
  stats: { value: string; label: string }[];
  quote: string;
  attribution: string;
}

const { kicker, title, description, stats, quote, attribution } = Astro.props;
---

<div class="rgrid grid grid-cols-[1.2fr_1fr] border-2 border-ink bg-white">
  <div class="p-8 border-r-2 border-ink">
    <div class="font-mono text-xs text-neutral-600 mb-2.5">{kicker}</div>
    <h3 class="font-heading font-bold text-2xl leading-tight text-ink mb-3">{title}</h3>
    <p class="text-[14.5px] leading-relaxed text-neutral-700 mb-5">{description}</p>
    <div class="flex gap-7">
      {
        stats.map((s) => (
          <div>
            <div class="font-heading font-extrabold text-[26px] text-ink">{s.value}</div>
            <div class="font-mono text-[11px] text-neutral-600">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
  <div class="p-8 flex flex-col justify-between bg-bg">
    <p class="font-medium text-[17px] leading-[1.55] text-ink m-0">“{quote}”</p>
    <div class="font-mono text-xs text-neutral-600 mt-4">— {attribution}</div>
  </div>
</div>
