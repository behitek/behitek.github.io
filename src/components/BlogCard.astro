---
import { formatDate } from '@utils/helpers';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  language: 'en' | 'vi';
  slug: string;
  readingTime?: number;
  variant?: 'list' | 'compact';
}

const { title, description, date, category, language, slug, readingTime, variant = 'list' } = Astro.props;
const tagline = `${category.toUpperCase()} · ${language.toUpperCase()}`;
---

{
  variant === 'compact' ? (
    <a
      href={`/blog/${slug}`}
      class="grid grid-cols-[100px_130px_1fr_auto] md:grid-cols-[120px_130px_1fr_auto] gap-5 items-baseline py-[18px] border-b border-border-light no-underline hover:bg-neutral-200 -mx-2 px-2"
    >
      <span class="font-mono text-xs text-neutral-600">{formatDate(date)}</span>
      <span class="font-mono text-[10.5px] font-semibold text-neutral-600">{tagline}</span>
      <span class="font-heading font-bold text-lg text-ink">{title}</span>
      <span class="text-ink">→</span>
    </a>
  ) : (
    <a
      href={`/blog/${slug}`}
      class="grid grid-cols-[130px_1fr_100px] md:grid-cols-[130px_1fr_140px] gap-6 py-6 border-b border-border-light no-underline hover:bg-neutral-200 -mx-2 px-2"
    >
      <div class="font-mono text-xs leading-[1.8] text-neutral-600">
        {formatDate(date)}
        <br />
        <span>{tagline}</span>
      </div>
      <div>
        <h2 class="font-heading font-bold text-[22px] text-ink mb-1.5">{title}</h2>
        <p class="text-sm leading-relaxed text-neutral-700 m-0">{description}</p>
      </div>
      <div class="font-mono text-xs text-neutral-600 text-right">
        {readingTime} phút đọc →
      </div>
    </a>
  )
}
