---
import { formatDate } from '@utils/helpers';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  language: 'en' | 'vi';
  slug: string;
  readingTime?: number;
  variant?: 'list' | 'compact';
}

const {
  title,
  description,
  date,
  category,
  language,
  slug,
  readingTime,
  variant = 'list',
} = Astro.props;
const tagline = `${category.toUpperCase()} · ${language.toUpperCase()}`;
---

{
  variant === 'compact' ? (
    <a
      href={`/blog/${slug}`}
      class="-mx-2 grid grid-cols-[1fr_auto] items-baseline gap-2 border-b border-border-light px-2 py-[18px] no-underline hover:bg-neutral-200 sm:grid-cols-[100px_130px_1fr_auto] sm:gap-5 md:grid-cols-[120px_130px_1fr_auto]"
    >
      <span class="font-mono text-xs text-neutral-600">{formatDate(date)}</span>
      <span class="font-mono text-[10.5px] font-semibold text-neutral-600">{tagline}</span>
      <span class="font-heading text-lg font-bold text-ink">{title}</span>
      <span class="text-ink">→</span>
    </a>
  ) : (
    <a
      href={`/blog/${slug}`}
      class="-mx-2 grid grid-cols-[130px_1fr_100px] gap-6 border-b border-border-light px-2 py-6 no-underline hover:bg-neutral-200 md:grid-cols-[130px_1fr_140px]"
    >
      <div class="font-mono text-xs leading-[1.8] text-neutral-600">
        {formatDate(date)}
        <br />
        <span>{tagline}</span>
      </div>
      <div>
        <h2 class="mb-1.5 font-heading text-[22px] font-bold text-ink">{title}</h2>
        <p class="m-0 text-sm leading-relaxed text-neutral-700">{description}</p>
      </div>
      <div class="text-right font-mono text-xs text-neutral-600">{readingTime} phút đọc →</div>
    </a>
  )
}
