---
---

<div
  id="toast-notification"
  class="pointer-events-none fixed bottom-6 right-6 z-50 flex items-center gap-2 border-2 border-ink bg-ink px-4 py-2.5 font-mono text-xs font-semibold text-bg shadow-lg opacity-0 translate-y-3 transition-all duration-200"
  role="status"
  aria-live="polite"
>
  <span id="toast-message">✓ Copied!</span>
</div>

<script>
  let toastTimeout: ReturnType<typeof setTimeout> | null = null;

  window.showToast = (message: string = '✓ Copied!') => {
    const toast = document.getElementById('toast-notification');
    const toastMsg = document.getElementById('toast-message');
    if (!toast || !toastMsg) return;

    toastMsg.textContent = message;
    toast.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');

    if (toastTimeout) clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      toast.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
    }, 2400);
  };
</script>
