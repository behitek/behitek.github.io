---
interface Props {
  lines: string[];
  interactive?: boolean;
}

const { lines, interactive = true } = Astro.props;
const fullText = lines.join('\n');

const PRESETS = [
  {
    cmd: 'cat core-strengths.txt',
    label: 'strengths',
    output: [
      '$ cat core-strengths.txt',
      '🤖 Agentic AI   : Multi-agent Orchestration · Tool Calling · Autonomous Agents',
      '💬 NLP          : Legal QA · Search & Re-rank · Vector Embeddings · ASR',
      '⚡ AI in SDLC   : AI-Assisted Full-stack Software Architecture & Delivery',
      '🛠️ Backend/Ops  : Python · FastAPI · Docker · Kubernetes · Linux',
    ].join('\n'),
  },
  {
    cmd: 'cat highlights.txt',
    label: 'highlights',
    output: [
      '$ cat highlights.txt',
      '🏆 1st Rank ALQAC 2022: Automated Legal Question Answering',
      '🌟 Top 30 Employee of the Year: VMO Holdings (2023)',
      '⚡ Champion AI4VN Hackathon 2019 & 2nd Prize VLSP ASR 2019',
      '🎓 Master of Information Science: JAIST Japan',
    ].join('\n'),
  },
  {
    cmd: 'ls projects/',
    label: 'projects',
    output: [
      '$ ls -la projects/',
      'drwxr-xr-x  LCOJ       20.000+ users · DMOJ Online Judge',
      'drwxr-xr-x  NexusAI    Multi-modal Enterprise RAG & AI Agents',
      'drwxr-xr-x  LinguistAI Automated 4-Skill English Evaluation',
    ].join('\n'),
  },
];
---

<div class="border-2 border-ink bg-ink">
  <div class="flex items-center justify-between border-b border-neutral-700 px-3 py-2">
    <div class="flex gap-1.5">
      <span class="h-[9px] w-[9px] rounded-full bg-neutral-600"></span>
      <span class="h-[9px] w-[9px] rounded-full bg-neutral-600"></span>
      <span class="h-[9px] w-[9px] rounded-full bg-accent"></span>
    </div>
    {
      interactive && (
        <div class="flex gap-1.5 font-mono text-[10px]">
          {PRESETS.map((p) => (
            <button
              type="button"
              class="term-cmd-btn border border-neutral-700 bg-neutral-900 px-2 py-0.5 text-neutral-400 hover:border-accent hover:text-accent cursor-pointer transition-colors"
              data-cmd-output={p.output}
            >
              ${p.label}
            </button>
          ))}
        </div>
      )
    }
  </div>
  <pre
    id="terminal-text"
    class="m-0 whitespace-pre-wrap px-[18px] py-4 font-mono text-[13px] leading-normal text-bg"
    data-full-text={fullText}><span id="terminal-cursor" class="inline-block h-[15px] w-[7px] align-[-2px] bg-accent animate-blink"></span></pre>
</div>

<script>
  const el = document.getElementById('terminal-text');
  const cursor = document.getElementById('terminal-cursor');
  const cmdBtns = document.querySelectorAll('.term-cmd-btn');

  if (el && cursor) {
    const fullText = el.getAttribute('data-full-text') || '';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let typeTimer: ReturnType<typeof setTimeout> | undefined;

    const typeText = (text: string) => {
      if (typeTimer) clearTimeout(typeTimer);
      const cleanText = text.replace(/(\n\$\s*)+$/g, '').trim();
      if (reduceMotion) {
        el.textContent = cleanText + '\n$ ';
        el.appendChild(cursor);
      } else {
        let i = 0;
        const target = cleanText + '\n$ ';
        const step = () => {
          if (i >= target.length) return;
          i += 2;
          el.textContent = target.slice(0, i);
          el.appendChild(cursor);
          typeTimer = setTimeout(step, 18);
        };
        step();
      }
    };

    typeText(fullText);

    cmdBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const output = btn.getAttribute('data-cmd-output');
        if (output) {
          cmdBtns.forEach((b) => b.classList.remove('border-accent', 'text-accent'));
          btn.classList.add('border-accent', 'text-accent');
          typeText(output);
        }
      });
    });
  }
</script>

