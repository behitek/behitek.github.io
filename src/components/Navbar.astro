---
import { NAV_LINKS } from '@utils/constants';
import Toast from '@components/Toast.astro';

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<nav
  class="sticky top-0 z-50 flex items-center justify-between h-16 px-6 md:px-12 bg-bg border-b-2 border-ink"
  data-screen-label="Nav"
>
  <a href="/" class="flex items-center gap-3 no-underline" aria-label="behitek - trang chủ">
    <img src="/favicon.svg" alt="" width="28" height="28" class="block" />
    <span class="font-heading font-extrabold text-xl text-ink tracking-tight"
      >behitek<span class="blink-cursor">_</span></span
    >
  </a>

  <div class="hidden md:flex items-center gap-6">
    {
      NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class={`font-mono text-[13px] no-underline flex items-center gap-1.5 ${isActive(link.href) ? 'text-accent' : 'text-ink'}`}
        >
          <span>{link.label}</span>
          {link.isNew && (
            <span class="bg-accent text-bg text-[9px] font-bold px-1 py-0.2 uppercase font-mono">
              DEMO
            </span>
          )}
        </a>
      ))
    }
  </div>

  <div class="hidden md:flex items-center gap-[18px]">
    <div class="flex font-mono text-[11px] font-semibold border border-ink">
      <span class="px-2 py-1 bg-ink text-bg">VI</span>
      <button
        type="button"
        id="lang-toggle"
        class="px-2 py-1 text-ink cursor-pointer bg-transparent border-0 hover:bg-neutral-200"
        >EN</button
      >
    </div>
    <a href="/contact" class="btn-primary py-2.5 px-[18px] text-sm">Nhận báo giá</a>
  </div>

  <div class="md:hidden flex items-center gap-3">
    <button
      id="mobile-menu-button"
      class="p-1 text-ink"
      aria-label="Mở menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="hidden md:hidden border-b-2 border-ink bg-bg">
  <div class="px-6 py-4 flex flex-col gap-3">
    {
      NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class={`font-mono text-sm no-underline flex items-center justify-between ${isActive(link.href) ? 'text-accent' : 'text-ink'}`}
        >
          <span>{link.label}</span>
          {link.isNew && (
            <span class="bg-accent text-bg text-[10px] font-bold px-1.5 py-0.5 uppercase font-mono">
              PROTOTYPE
            </span>
          )}
        </a>
      ))
    }
    <a href="/contact" class="btn-primary text-sm w-fit">Nhận báo giá</a>
  </div>
</div>

<Toast id="lang-toast" message="EN version dùng cùng layout (nội dung sẽ dịch khi dev)" />

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  const langToggle = document.getElementById('lang-toggle');
  const langToast = document.getElementById('lang-toast');
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  langToggle?.addEventListener('click', () => {
    langToast?.classList.remove('hidden');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      langToast?.classList.add('hidden');
    }, 3200);
  });
</script>
