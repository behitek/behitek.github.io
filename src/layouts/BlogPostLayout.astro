---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '@components/TableOfContents.astro';
import Giscus from '@components/Giscus.astro';
import { formatDate } from '@utils/helpers';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { slug: string; text: string; depth: number }[];
  readingTime: number;
}

const { post, headings, readingTime } = Astro.props;
const { title, description, date, updated, category, tags, language } = post.data;

const shareUrl = new URL(`/blog/${post.slug}`, Astro.site).toString();
const shareTitle = encodeURIComponent(title);
---

<BaseLayout
  title={title}
  description={description}
  article={true}
  publishedTime={date}
  modifiedTime={updated}
>
  <div id="reading-progress" class="reading-progress" style="width: 0%"></div>

  <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr]">
    <aside class="hidden border-r border-border-light py-12 pl-12 lg:block">
      <a
        href="/blog"
        class="mb-5 inline-block font-mono text-xs text-neutral-600 no-underline hover:text-accent"
      >
        ← cd ../blog
      </a>
      <TableOfContents headings={headings} />
    </aside>

    <article class="max-w-[760px] p-8 md:p-12">
      <div class="mb-3.5 font-mono text-xs text-neutral-600">
        ~/blog/<span class="text-accent">{post.slug}</span> · {formatDate(date)} · {readingTime} phút
        đọc ·{' '}
        <span class="text-accent">{category.toUpperCase()} · {language.toUpperCase()}</span>
      </div>

      <h1 class="mb-5 font-heading text-[40px] font-extrabold leading-[1.1] text-ink">{title}</h1>

      <p class="mb-5 text-base leading-relaxed text-neutral-700">{description}</p>

      <div class="prose prose-lg">
        <slot />
      </div>

      {
        tags.length > 0 && (
          <div class="mb-6 mt-6 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="tag-pill">#{tag}</span>
            ))}
          </div>
        )
      }

      <div class="my-6 flex items-center gap-3 border-t-2 border-ink py-4">
        <span class="font-mono text-[11px] font-semibold tracking-[0.08em] text-neutral-600"
          >CHIA SẺ</span
        >
        <a
          href={`https://x.com/intent/tweet?text=${shareTitle}&url=${encodeURIComponent(shareUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-ink px-3.5 py-1.5 font-mono text-xs font-semibold text-ink no-underline hover:bg-ink hover:text-bg"
        >
          X
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-ink px-3.5 py-1.5 font-mono text-xs font-semibold text-ink no-underline hover:bg-ink hover:text-bg"
        >
          LinkedIn
        </a>
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-ink px-3.5 py-1.5 font-mono text-xs font-semibold text-ink no-underline hover:bg-ink hover:text-bg"
        >
          Facebook
        </a>
        <button
          id="copy-link"
          type="button"
          class="cursor-pointer border-2 border-ink bg-transparent px-3.5 py-1.5 font-mono text-xs font-semibold text-ink hover:bg-ink hover:text-bg"
        >
          copy link
        </button>
      </div>

      <div class="flex items-center gap-5 border-2 border-ink bg-white p-5">
        <img
          src="/images/me.png"
          alt="Hiếu Nguyễn"
          class="grayscale-photo h-16 w-16 flex-none border border-ink object-cover"
        />
        <div class="flex-1">
          <div class="font-heading text-[15px] font-bold text-ink">Hiếu Nguyễn — AI Engineer</div>
          <div class="text-[13px] leading-relaxed text-neutral-700">
            8 năm xây hệ thống AI production. Nhận tư vấn RAG/LLM và triển khai online judge.
          </div>
        </div>
        <a href="/contact" class="btn-primary flex-none px-4 py-2.5 text-sm">Liên hệ →</a>
      </div>

      <Giscus />
    </article>
  </div>
</BaseLayout>

<script>
  const updateReadingProgress = () => {
    const winScroll = document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const progressBar = document.getElementById('reading-progress');
    if (progressBar) {
      progressBar.style.width = scrolled + '%';
    }
  };

  window.addEventListener('scroll', updateReadingProgress);

  document.getElementById('copy-link')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(window.location.href);
    const button = document.getElementById('copy-link');
    if (button) {
      const originalText = button.textContent;
      button.textContent = '✓ đã copy';
      setTimeout(() => {
        button.textContent = originalText;
      }, 2000);
    }
  });

  document.querySelectorAll('.prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.className = 'copy-button';
    button.textContent = 'Copy';
    button.setAttribute('aria-label', 'Copy code to clipboard');

    button.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      if (code) {
        const text = code.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = 'Copied!';
          button.classList.add('copied');
          setTimeout(() => {
            button.textContent = 'Copy';
            button.classList.remove('copied');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy code:', err);
          button.textContent = 'Failed';
          setTimeout(() => {
            button.textContent = 'Copy';
          }, 2000);
        }
      }
    });

    pre.appendChild(button);
  });

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href') || '');
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
